\input stridi-test.tex\relax

% NOTE: \wires needs the fit library, which the package doesn't load (see no-fit.lvt).
\usetikzlibrary{fit}

\begin{document}

\START

\TEST{a wire between two ports}{
  \PICTURE{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \node[box=0/0/1/0, square] (b) at (0pt,200pt) {};
    \LOG{\wires{a = {north.1 = b.south.1}}}
  }
}

\TEST{wires take TikZ keys}{
  \PICTURE{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \node[box=0/0/1/0, square] (b) at (0pt,200pt) {};
    \LOG{\wires[dashed, line width=2pt]{a = {north.1 = b.south.1}}}
  }
}

\TEST{keys can override the angles of wires}{
  \PICTURE{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \node[box=0/0/1/0, square] (b) at (0pt,200pt) {};
    \LOG{\wires[out=0, in=180]{a = {north.1 = b.south.1}}}
  }
}

\TEST{a wire from the boundary}{
  \PICTURE{
    \node[box=0/0/0/1, square] (a) at (0pt,0pt) {};
    \LOG{\wires{@ = {west = a.west.1}}}
  }
}

\TEST{wires in a shifted scope are drawn as without the shift}{
  \PICTURE{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \node[box=0/0/1/0, square] (b) at (0pt,200pt) {};
    \LOG{\wires{a = {north.1 = b.south.1, east = @.east}}}
  }
  \TYPE{-- shifted:}
  \PICTURE{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \node[box=0/0/1/0, square] (b) at (0pt,200pt) {};
    \begin{scope}[shift={(100pt,50pt)}]
      \LOG{\wires{a = {north.1 = b.south.1, east = @.east}}}
    \end{scope}
  }
}

\TEST{the example of boxes and the boundary in the documentation}{
  \PICTURE[scale=0.6]{
    \node[box=0/2/0/1] (A) at (-2, 0) {A};
    \node[box=0/1/0/2] (B) at (+2, 0) {B};
    \node[box=0/1/0/1] (C) at ( 0,+1) {C};
    \node[box=0/1/0/1] (D) at ( 0,-1) {D};
    \LOG{\wires{
      A = { east.1 = C.west
          , east.2 = D.west
          , west = @.west },
      B = { east = @.east },
      C = { east = B.west.1 },
      D = { east = B.west.2 },
    }}
  }
}

\TEST{the example of dots in the documentation}{
  \PICTURE{
    \node[box=0/1/0/2] (A) at ( 0,+1) {A};
    \node[box=0/2/0/1] (B) at ( 0,-1) {B};
    \node[dot] (x) at (+1, 0) {};
    \node[dot] (y) at (-1, 0) {};
    \LOG{\wires[looseness=1.5,-stealth]{
      A = { east.1 = x.north
          , west.1 = @.west },
      B = { east.1 = x.south
          , east.2 = @.east },
      y = { north = A.west.2
          , south = B.west
          , west = @.west },
      x = { east = @.east },
    }}
  }
}

% BUG: the first wire should end at type1.south, and draw no errors.
\TEST{BUG: the example of issue 15, with node names longer than a letter}{
  \PICTURE{
    \node[box=0/0/1/0, draw=none] (type1) at (-3,0) {n};
    \node[box=0/0/1/0, draw=none] (type21) at (-1,0) {n^l};
    \node[box=0/0/1/0, draw=none] (type22) at (0,0) {s};
    \LOG{\wires{
      type21 = {south = type1.south},
      type22 = {south = @.south},
    }}
  }
}

% TBC: loose ends went in a third argument up to 0.2.1, which is now silently ignored: should it give a warning?
\TEST{TBC: a third argument of wires is ignored}{
  % NOTE: engines log the characters lost in the null font differently, so they aren't logged.
  \tracinglostchars=0
  \PICTURE{
    \node[box=0/0/1/0, square] (a) at (0pt,0pt) {};
    \LOG{\wires{}{a.south.1}}
  }
}

% TBC: should wires leave a rotated box at a rotated angle? Here a.north.1 is on the left of the box, but the wire leaves upwards.
\TEST{TBC: wires leave rotated boxes as if they weren't rotated}{
  \PICTURE{
    \node[box=1/0/0/0, square, rotate=90] (a) at (0pt,0pt) {};
    \node[box=0/0/1/0, square] (b) at (0pt,200pt) {};
    \LOG{\wires{a = {north.1 = b.south.1}}}
  }
}

% TBC: should rotated pictures be supported? Nodes don't turn with the picture, but the angles of wires do, so the wire from a.north.1 leaves sideways; the margins of the boundary turn too, so it's narrower than the picture, and the wire to @.east collapses to a point.
\TEST{TBC: wires in a rotated picture}{
  \PICTURE[rotate=90]{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \node[box=0/0/1/0, square] (b) at (0pt,200pt) {};
    \LOG{\wires{a = {north.1 = b.south.1, east = @.east}}}
  }
}

\TEST{a wire across the boundary}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \LOG{\wires{@ = {west = @.east}}}
  }
}

% BUG: the boundary should get a size even when nothing else is drawn, as in a diagram of an identity.
\TEST{BUG: a picture with only a wire across the boundary}{
  \PICTURE{
    \LOG{\wires{@ = {west = @.east}}}
  }
}

% BUG: either the wire should be drawn without errors, or the error should say what's wrong.
\TEST{BUG: a wire from an anchor without angle}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \node[box, square] (b) at (0pt,200pt) {};
    \LOG{\wires{a = {center = b.south}}}
  }
}

% BUG: the error should name the node `nowhere'.
\TEST{BUG: a wire to a node that doesn't exist}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \LOG{\wires{a = {north = nowhere.south}}}
  }
}

\TEST{the boundary has no ports}{
  \PICTURE{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \LOG{\wires{a = {north.1 = @.north.1}}}
  }
}

\TEST{a wire from a port that doesn't exist}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \node[box, square] (b) at (0pt,200pt) {};
    \LOG{\wires{a = {north.7 = b.south}}}
  }
}

\END
