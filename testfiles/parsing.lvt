\input stridi-test.tex\relax

\ExplSyntaxOn

\tl_new:N \l_test_node_tl
\tl_new:N \l_test_anchor_tl

% \SPLIT{<end>}: log how the end of a wire is split into node and anchor.
\NewDocumentCommand \SPLIT { m }
  {
    \__stridi_split_node_anchor:NNn \l_test_node_tl \l_test_anchor_tl { #1 }
    \TYPE
      {
        \tl_to_str:n { #1 } ~ -> ~
        node ~ [ \tl_to_str:N \l_test_node_tl ] ~
        anchor ~ [ \tl_to_str:N \l_test_anchor_tl ]
      }
  }

\cs_new_protected:Npn \test_log_wire:nnnnn #1#2#3#4#5
  {
    \TYPE
      {
        [ \tl_to_str:n { #1 } ] ~
        [ \tl_to_str:n { #2 } ] . [ \tl_to_str:n { #3 } ] ~ -- ~
        [ \tl_to_str:n { #4 } ] . [ \tl_to_str:n { #5 } ]
      }
  }

% \MAP[<keys>]{<connectivity>}: log the wires that \wires would draw, as [keys] [node].[anchor] -- [node].[anchor].
\NewDocumentCommand \MAP { O{} m }
  { \__stridi_adj_map_function:nnN { #1 } { #2 } \test_log_wire:nnnnn }

\ExplSyntaxOff

\begin{document}

\START

\TEST{splitting ends into node and anchor}{
  \SPLIT{a.north}
  \SPLIT{a.north.1}
  \SPLIT{a.north east}
  \SPLIT{@.west}
  \SPLIT{a}
  \SPLIT{a.}
  \SPLIT{.north}
}

\TEST{splitting ends whose node name is longer than a letter}{
  \SPLIT{ab.north}
  \SPLIT{box1.north.1}
  \SPLIT{my node.north}
  \SPLIT{ab}
}

\TEST{one wire}{
  \MAP{a = {north = b.south}}
}

\TEST{wires come in order, with spaces trimmed}{
  \MAP{
    a = { east.1 = c.west
        , east.2 = d.west
        , west = @.west },
    b = { east = @.east },
  }
}

\TEST{keys are passed through}{
  \MAP[looseness=1.5, -stealth]{a = {north = b.south}}
}

% NOTE: \wires reports such a target as an error (see wires.lvt).
\TEST{a target without anchor has an empty anchor}{
  \MAP{a = {north = b}}
}

\TEST{a target whose node name is longer than a letter}{
  \MAP{ab = {north = cd.south}}
}

\TEST{a node listed twice keeps the wires of both entries}{
  \MAP{a = {north = b.south}, a = {south = c.north}}
}

% TBC: should both wires be drawn, so that an anchor can fan out, or should this be an error?
\TEST{TBC: an anchor listed twice keeps only its last wire}{
  \MAP{a = {north = b.south, north = c.south}}
}

\TEST{a node without wires is an error}{
  \MAP{a, b = {north = c.south}}
}

\TEST{no wires}{
  \MAP{}
  \MAP{a = {}}
}

\END
