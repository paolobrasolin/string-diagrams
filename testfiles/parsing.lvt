\input stridi-test.tex\relax

\ExplSyntaxOn

\tl_new:N \l_test_node_tl
\tl_new:N \l_test_anchor_tl

% \SPLIT{<end>}: log how the end of a wire is split into node and anchor.
\NewDocumentCommand \SPLIT { m }
  {
    \__stridi_split_node_anchor:NNn \l_test_node_tl \l_test_anchor_tl { #1 }
    \TYPE
      {
        \tl_to_str:n { #1 } ~ -> ~
        node ~ [ \tl_to_str:N \l_test_node_tl ] ~
        anchor ~ [ \tl_to_str:N \l_test_anchor_tl ]
      }
  }

\cs_new_protected:Npn \test_log_wire:nnnnn #1#2#3#4#5
  {
    \TYPE
      {
        [ \tl_to_str:n { #1 } ] ~
        [ \tl_to_str:n { #2 } ] . [ \tl_to_str:n { #3 } ] ~ -- ~
        [ \tl_to_str:n { #4 } ] . [ \tl_to_str:n { #5 } ]
      }
  }

% \MAP[<keys>]{<connectivity>}: log the wires that \wires would draw, as [keys] [node].[anchor] -- [node].[anchor].
\NewDocumentCommand \MAP { O{} m }
  { \__stridi_adj_map_function:nnN { #1 } { #2 } \test_log_wire:nnnnn }

\ExplSyntaxOff

\begin{document}

\START

\TEST{splitting ends into node and anchor}{
  \SPLIT{a.north}
  \SPLIT{a.north.1}
  \SPLIT{a.north east}
  \SPLIT{@.west}
  \SPLIT{a}
  \SPLIT{a.}
  \SPLIT{.north}
}

\TEST{splitting ends whose node name is longer than a letter}{
  \SPLIT{ab.north}
  \SPLIT{box1.north.1}
  \SPLIT{my node.north}
  \SPLIT{ab}
}

\TEST{one wire}{
  \MAP{a = {north = b.south}}
}

\TEST{wires come in order, with spaces trimmed}{
  \MAP{
    a = { east.1 = c.west
        , east.2 = d.west
        , west = @.west },
    b = { east = @.east },
  }
}

\TEST{keys are passed through}{
  \MAP[looseness=1.5, -stealth]{a = {north = b.south}}
}

% NOTE: \wires reports such a target as an error (see wires.lvt).
\TEST{a target without anchor has an empty anchor}{
  \MAP{a = {north = b}}
}

\TEST{a target whose node name is longer than a letter}{
  \MAP{ab = {north = cd.south}}
}

\TEST{a node listed twice keeps the wires of both entries}{
  \MAP{a = {north = b.south}, a = {south = c.north}}
}

\TEST{an anchor listed twice fans out}{
  \MAP{a = {north = b.south, north = c.south}}
}

\TEST{a node without wires is an error}{
  \MAP{a, b = {north = c.south}}
}

\TEST{an anchor without target is an error}{
  \PICTURE{\node[box=1/0/0/0] (a) {};}
  \MAP{a = {north, south = b.north}}
}

\TEST{no wires}{
  \MAP{}
  \MAP{a = {}}
}

\TEST{a wire written whole}{
  \MAP{a.north = b.south}
  \MAP{a.north east = b.south.1}
}

\TEST{wires sharing their beginning up to the equals sign}{
  \MAP{a.north = {b.south, c.south}}
}

\TEST{wires sharing their target node}{
  \MAP{a.north = {b = {south.1, south.2}, c.south}}
  \MAP{a.north = {b = south.1}}
}

\TEST{groups nest, and all groupings of the same wires agree}{
  \MAP{a = {north = {b = {south.1, south.2}}}}
  \MAP{a = {north = b.south.1, north = b.south.2}}
  \MAP{a.north = {b.south.1, b.south.2}}
  \MAP{a.north = b.south.1, a.north = b.south.2}
}

\TEST{entries at the top mix wires and groups}{
  \MAP{a.north = b.south, c = {west = @.west}, @.east = c.east}
}

% NOTE: the wires start from a node without anchor, which \wires reports until such ends are supported.
\TEST{an item without equals sign after a node is a target, if the node exists}{
  \PICTURE{\node (b) {}; \node (c) {};}
  \MAP{a = {b, c.west}}
  \MAP{a = b}
}

% NOTE: the shape of the node the wires start from tells its anchors, as for a.north.1, a box with a port; a.30 is no named anchor.
\TEST{an anchor without target, after a node, is an error}{
  \MAP{a = {north.1}}
  \MAP{a = {south west}}
  \MAP{a = {center}}
  \MAP{a = {30}}
}

\TEST{an item that is neither a node nor an anchor, after a node, is an error}{
  \MAP{a = {gg}}
  \MAP{a = {gg.south}}
  \MAP{nowhere = {north}}
}

\TEST{an end without target at the top is an error}{
  \MAP{a.north}
}

\TEST{a group can't begin inside an anchor}{
  \MAP{a.north = {b.south = {1, 2}}}
}

\TEST{the anchors of a target take no value}{
  \MAP{a.north = {b = {south = c}}}
}

\TEST{keys before a wire, a value or an item}{
  \MAP{[red] a.north = b.south}
  \MAP{a.north = [red] b.south}
  \MAP{a = {[red] north = b.south, south = [blue] c.north}}
  \MAP{a.north = {[red] b.south, c.south}}
  \MAP{a.north = {b = {[red] south.1, south.2}}}
}

\TEST{keys add up from the call down to each wire}{
  \MAP[thick]{[red] a = [dashed] {[blue] north = [->] {b.south, [<-] c = [gray] {[cyan] south}}}}
}

\TEST{keys hold commas, braces and brackets, as in TikZ}{
  \MAP{a.north = [red, dashed] b.south}
  \MAP{a.north = [label={[red]x}, "y" {pos=1}] b.south}
  \MAP{a.north = [red] [thick] b.south}
}

\TEST{keys keep the spaces of node names and anchors around them}{
  \MAP{[red] my a.north east = [blue] my b.south west}
}

\TEST{keys before an entry without wires or target are dropped with it}{
  \MAP{[red] a}
  \MAP{[red] a.north}
}

\TEST{an unclosed bracket is an error}{
  \MAP{a.north = [red b.south}
}

\TEST{a group in braces that begins with keys is a group, not keys}{
  \MAP{a.north = {c = [gray] {[cyan] south}}}
  \MAP{a = [dashed] {[blue] north = b.south}}
}

\TEST{keys after the beginning of an item or value are an error}{
  \MAP{a.north = b.south [red]}
  \MAP{a [red] = {north = b.south}}
  \MAP{a = {north [red] = b.south, south = c.north}}
}

\TEST{empty items and groups give no wires, silently}{
  \MAP{,, a.north = b.south ,,}
  \MAP{a.north = { , b.south , }}
  \MAP{a.north = {}}
  \MAP{a.north = { b = {} }}
  \MAP{a = { north = {} }}
}

\TEST{extra braces around a name or a value are dropped}{
  \MAP{{a.north} = {b.south}}
  \MAP{a = {{north = b.south}}}
  \MAP{a.north = {{b.south, c.south}}}
  \MAP{a.north = { {b} = {south} }}
}

\TEST{a group in braces where a name belongs is an error}{
  \MAP{a.north = { {b.south, c.south}, d.south }}
  \MAP{a.north = {b.south} {c.south}}
  \MAP{{a.north = b.south}}
  \MAP{a = { {north, south} = b.south }}
}

\TEST{keys followed by nothing are an error}{
  \MAP{[red]}
  \MAP{[red] = b.south}
  \MAP{a = { [red] }}
  \MAP{a.north = [red]}
  \MAP{a.north = [red] {}}
  \MAP{a.north = { b = [red] }}
  \MAP{a.north = { b = { [red] } }}
}

\TEST{a closing bracket without its opening one is an error}{
  \MAP{a.north = b.south], c.north = d.south}
  \MAP{a.north = b.south, c = {north = d.south]}}
}

% NOTE: as in TikZ, which reads (a . north) as the node `a ' and the anchor ` north'.
\TEST{spaces around a dot belong to the node and the anchor}{
  \MAP{a . north = b . south}
}

% NOTE: as in TikZ, which reads (x.y.north) as the node x; a dot at the end leaves an empty anchor.
\TEST{a node name ends at the first dot}{
  \MAP{x.y.north = b.south}
  \MAP{a. = b.south}
}

\TEST{the boundary is a node like any other}{
  \MAP{@ = {west = a.west}, a.east = @.east, a.north = { @ = { north } }}
}

\END
