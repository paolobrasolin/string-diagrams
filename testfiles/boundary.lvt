\input stridi-test.tex\relax

\ExplSyntaxOn

% \TARGET{<node>}{<anchor>}{<anchor of @>}: log where a wire from an anchor reaches the boundary.
\NewDocumentCommand \TARGET { m m m }
  {
    \SHOWPOINT { #1.#2 ~ -> ~ @.#3 }
      { \__stridi_point_across:nnnn { #1 } { #2 } { @ } { #3 } }
  }

\tl_new:N \l_test_end_tl

% \PROJ{<node>}{<anchor>}{<node>}{<anchor>}{<true or false>}: log the end that the first node and anchor give to a wire, facing inwards or not, as stored and as TikZ reads it.
\NewDocumentCommand \PROJ { m m m m m }
  {
    \use:e
      {
        \exp_not:N \__stridi_end_coordinate:NnnnnN \exp_not:N \l_test_end_tl
          { \exp_not:n { #1 } } { \exp_not:n { #2 } } { \exp_not:n { #3 } } { \exp_not:n { #4 } }
          \exp_not:c { c_ #5 _bool }
      }
    \SHOWPOINT { #1.#2 ~ -- ~ #3.#4 ~ -> ~ ( \tl_to_str:N \l_test_end_tl ) }
      { \use:c { tikz@scan@one@point } \use:n ( \l_test_end_tl ) }
  }

\ExplSyntaxOff

% \BOUNDARY{<anchor>}: log an anchor of the boundary that the calls of \wires share in a picture, which has no name outside them.
\newcommand\BOUNDARY[1]{\SHOWPOINT{@.#1}{\pgfpointanchor{string-diagrams boundary}{#1}}}

% A boundary with sides at 200pt from the origin, and a box beside its center.
\newcommand\SETUP{
  \node[minimum size=400pt, inner sep=0pt, outer sep=0pt] (@) at (0pt,0pt) {};
  \node[box=1/1/1/1, square] (a) at (20pt,10pt) {};
}

\begin{document}

\START

\TEST{wires between facing sides go straight}{
  \PICTURE{
    \SETUP
    \TARGET{a}{north}{north}
    \TARGET{a}{south}{north}
    \TARGET{a}{north}{south}
    \TARGET{a}{south}{south}
    \TARGET{a}{east}{east}
    \TARGET{a}{west}{east}
    \TARGET{a}{east}{west}
    \TARGET{a}{west}{west}
  }
}

\TEST{wires between sides at right angles bend}{
  \PICTURE{
    \SETUP
    \TARGET{a}{east}{north}
    \TARGET{a}{east}{south}
    \TARGET{a}{west}{north}
    \TARGET{a}{west}{south}
    \TARGET{a}{north}{east}
    \TARGET{a}{north}{west}
    \TARGET{a}{south}{east}
    \TARGET{a}{south}{west}
  }
}

% NOTE: a.north is at y=70pt, so the end would sit at y=205.95917pt, above the top of the boundary at y=200pt.
\TEST{a bent wire ends at most at the corner of the boundary}{
  \PICTURE{
    \SETUP
    \TARGET{a}{north}{west}
  }
}

\TEST{wires from ports go like wires from their side}{
  \PICTURE{
    \SETUP
    \TARGET{a}{north.1}{north}
    \TARGET{a}{east.1}{north}
  }
}

% NOTE: wires from a corner end offset to the side that the corner points to, whichever side of the boundary they reach.
\TEST{wires from corners end offset along their diagonal}{
  \PICTURE{
    \SETUP
    \TARGET{a}{north east}{north}
    \TARGET{a}{north east}{east}
    \TARGET{a}{south west}{west}
    \TARGET{a}{north east}{west}
    \TARGET{a}{south west}{north}
    \TARGET{a}{south east}{north}
    \TARGET{a}{north west}{south}
  }
}

% NOTE: \wires stops wires from anchors without a direction before they get here (see wires.lvt); wires to other anchors of the boundary, such as its corners, end at them.
\TEST{wires involving other anchors end at the anchor of the boundary}{
  \PICTURE{
    \SETUP
    \TARGET{a}{center}{north}
    \TARGET{a}{north}{north east}
    \TARGET{a}{north}{center}
  }
}

\TEST{ends facing inwards on a side are computed, others are anchors}{
  \PICTURE{
    \SETUP
    \PROJ{a}{north}{b}{south}{false}
    \PROJ{@}{north}{a}{north}{true}
    \PROJ{@}{north east}{a}{north}{true}
  }
}

\TEST{the boundary surrounds the picture}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \wires{}
    \BOUNDARY{north east}
    \BOUNDARY{south west}
  }
}

\TEST{a second call of wires reuses the boundary, and a new picture gets its own}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \wires{}
    \BOUNDARY{north east}
    \wires{}
    \BOUNDARY{north east}
  }
  \PICTURE{
    \node[box, minimum size=40pt, inner sep=0pt, outer sep=0pt] (a) at (0pt,0pt) {};
    \wires{}
    \BOUNDARY{north east}
  }
}

% NOTE: so nodes are best drawn before wires, as the documentation says.
\TEST{nodes drawn after the first call of wires are outside the boundary}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \wires{}
    \node[box, square] (b) at (200pt,0pt) {};
    \wires{}
    \BOUNDARY{north east}
    \SHOWANCHOR{b}{north east}
  }
}

% NOTE: the node named @ by \SETUP still exists here, as node names outlive their pictures; this one replaces it.
\TEST{inside a call @ is its boundary, and a node of one's own named @ is put back after}{
  \PICTURE{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \node[minimum size=10pt, inner sep=0pt, outer sep=0pt] (@) at (100pt,0pt) {};
    \LOG{\wires{a.north.1 = @}}
    \SHOWANCHOR{@}{north east}
  }
}

\TEST{a boundary by hand surrounds the picture so far, as the boundary of the picture does}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \node[boundary] (hand) {};
    \SHOWANCHOR{hand}{north east}
    \SHOWANCHOR{hand}{south west}
  }
  \PICTURE{
    \node[boundary] (empty) {};
    \SHOWANCHOR{empty}{north east}
  }
}

\TEST{the margins of a boundary are its inner xsep and inner ysep, and fit chooses what it surrounds}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \node[box, square] (b) at (200pt,0pt) {};
    \node[boundary, inner xsep=10pt, inner ysep=5pt, outer sep=0pt] (margins) {};
    \SHOWANCHOR{margins}{north east}
    \SHOWANCHOR{margins}{south west}
    \node[boundary, fit=(a)] (around a) {};
    \SHOWANCHOR{around a}{north east}
  }
}

% NOTE: so a boundary with box is not drawn unless it says so.
\TEST{on a boundary box gives ports only}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \LOG{\node[boundary, box=1/0/1/0] (ported) {};}
    \SHOWANCHOR{ported}{north.1}
    \SHOWANCHOR{ported}{south.1}
  }
}

\TEST{a boundary without a name is an error}{
  \PICTURE{
    \node[box, square] (a) at (0pt,0pt) {};
    \node[boundary] {};
  }
}

\END
