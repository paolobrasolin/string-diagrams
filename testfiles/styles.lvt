\input stridi-test.tex\relax

\begin{document}

\START

\TEST{a box is drawn}{
  \PICTURE{
    \LOG{\node[box] (a) at (0pt,0pt) {};}
  }
}

\TEST{a box is at least 2em wide and high, with .5em of padding}{
  \PICTURE{
    \node[box] (a) at (0pt,0pt) {};
    \node[box] (b) at (0pt,0pt) {\rule{30pt}{0pt}};
    \SHOWANCHOR{a}{north east}
    \SHOWANCHOR{b}{north east}
  }
}

\TEST{the label of a box is in math mode}{
  \PICTURE{
    \node[box] (a) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
  }
}

% NOTE: the box style already puts labels in math mode, so dollars in them break the node; the documentation says so.
\TEST{a box label in dollars breaks the node}{
  % NOTE: engines log the characters lost in the null font differently, so they aren't logged.
  \tracinglostchars=0
  \PICTURE{
    \node[box] (a) at (0pt,0pt) {$f$};
  }
}

\TEST{box math=false puts the label of a box in text mode}{
  \PICTURE{
    \node[box, box math=false] (a) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
    \node[box math=false, box] (b) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
  }
}

\TEST{box math works on a picture and a scope, and means true without a value}{
  \begin{tikzpicture}[box math=false]
    \node[box] (a) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
    \begin{scope}[box math]
      \node[box] (b) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
    \end{scope}
    \node[box, box math=true] (c) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
    \node[box] (d) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
  \end{tikzpicture}
}

\TEST{a box label in dollars is fine with box math=false}{
  \PICTURE{
    \node[box, box math=false] (a) at (0pt,0pt) {$f$\ifmmode\TYPE{math}\else\TYPE{text}\fi};
    \SHOWANCHOR{a}{north east}
  }
}

\TEST{a box label in math mode already stays in it}{
  \PICTURE{
    \node[execute at begin node=$, execute at end node=$, box] (a) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
    \node[box] (b) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
  }
}

\TEST{box math takes true or false only}{
  \PICTURE{
    \node[box, box math=maybe] (a) at (0pt,0pt) {};
  }
}

\TEST{a dot is filled}{
  \PICTURE{
    \LOG{\node[dot] (a) at (0pt,0pt) {};}
  }
}

\TEST{a dot is .4em wide}{
  \PICTURE{
    \node[dot] (a) at (0pt,0pt) {};
    \SHOWANCHOR{a}{north}
    \SHOWANCHOR{a}{east}
  }
}

\TEST{the long names draw the same box and dot as the short ones}{
  \PICTURE{
    \LOG{\node[box=1/0/1/0] (a) at (0pt,0pt) {};}
    \LOG{\node[string diagrams/box=1/0/1/0] (b) at (0pt,0pt) {};}
    \SHOWANCHOR{a}{north.1}
    \SHOWANCHOR{b}{north.1}
    \LOG{\node[dot] (c) at (0pt,0pt) {};}
    \LOG{\node[string diagrams/dot] (d) at (0pt,0pt) {};}
  }
}

\TEST{the long names draw the same wire and boundary as the short ones}{
  \PICTURE{
    \node[box=1/0/1/0] (a) at (0pt,0pt) {};
    \node[box=1/0/1/0] (b) at (10pt,40pt) {};
    \LOG{\draw (a.north.1) to[wire] (b.south.1);}
    \LOG{\draw (a.north.1) to[string diagrams/wire] (b.south.1);}
    \node[boundary] (B) {};
    \node[string diagrams/boundary] (C) {};
    \SHOWANCHOR{B}{north east}
    \SHOWANCHOR{C}{north east}
  }
}

% NOTE: the two pictures must log the same operators: the package doesn't use the short names itself.
\TEST{redefining the short names doesn't change what the package draws}{
  \PICTURE{
    \node[string diagrams/box=1/0/1/0] (a) at (0pt,0pt) {};
    \node[string diagrams/dot] (b) at (10pt,40pt) {};
    \LOG{\wires{@.south = a.south.1, a.north.1 = ["" beyond end] b, b = ["" beside start] @.north}}
    \SHOWANCHOR{string-diagrams boundary}{north east}
  }
  \PICTURE[
    box/.style={dashed}, dot/.style={dashed}, wire/.style={dashed}, boundary/.style={draw, dashed},
    beyond/.style={dashed}, beside/.style={dashed}, beyond end/.style={dashed}, beside start/.style={dashed},
    box math/.style={dashed}, wire flow/.style={dashed},
  ]{
    \node[string diagrams/box=1/0/1/0] (a) at (0pt,0pt) {};
    \node[string diagrams/dot] (b) at (10pt,40pt) {};
    \LOG{\wires{@.south = a.south.1, a.north.1 = ["" string diagrams/beyond end] b, b = ["" string diagrams/beside start] @.north}}
    \SHOWANCHOR{string-diagrams boundary}{north east}
  }
}

\TEST{the other keys work by their long names}{
  \PICTURE[string diagrams/box math=false, string diagrams/wire flow=east]{
    \node[box=0/1/0/1] (a) at (0pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
    \node[box=0/1/0/1, string diagrams/box math] (b) at (40pt,0pt) {\ifmmode\TYPE{math}\else\TYPE{text}\fi};
    \LOG{\wires{a = b}}
  }
}

\TEST{box ports work by their long names, which hold the counts}{
  \PICTURE[box ports/.style={dashed}, box ports north/.style={dashed}]{
    \node[box, string diagrams/box ports=1/2/3/4, string diagrams/box ports north=5] (a) at (0pt,0pt) {};
    \SHOWANCHOR{a}{north.5}
    \SHOWANCHOR{a}{west.4}
    \node[box=2/0/0/0] (b) at (0pt,0pt) {\TYPE{\pgfkeysvalueof{/tikz/string diagrams/box ports north}}};
    \SHOWANCHOR{b}{north.2}
  }
}

\TEST{every wire reaches wires, and so does its long name}{
  \PICTURE[every wire/.style={dashed}]{
    \node[box=1/0/1/0] (a) at (0pt,0pt) {};
    \node[box=1/0/1/0] (b) at (0pt,40pt) {};
    \LOG{\wires[boundary=none]{a = b}}
  }
  \PICTURE[string diagrams/every wire/.style={dashed}]{
    \node[box=1/0/1/0] (a) at (0pt,0pt) {};
    \node[box=1/0/1/0] (b) at (0pt,40pt) {};
    \LOG{\wires[boundary=none]{a = b}}
  }
}

\END
