\input stridi-test.tex\relax

\ExplSyntaxOn

\tl_new:N \l_test_angle_tl

% \ANGLE{<anchor>}: log the angle at which a wire leaves an anchor outwards.
\NewDocumentCommand \ANGLE { m }
  {
    \__stridi_anchor_to_angle:Nn \l_test_angle_tl { #1 }
    \TYPE { #1 ~ -> ~ [ \tl_to_str:N \l_test_angle_tl ] }
  }

\ExplSyntaxOff

\begin{document}

\START

\TEST{wires leave sides outwards}{
  \ANGLE{north}
  \ANGLE{east}
  \ANGLE{south}
  \ANGLE{west}
}

\TEST{wires leave ports like their side}{
  \ANGLE{north.1}
  \ANGLE{east.2}
  \ANGLE{south.3}
  \ANGLE{west.4}
}

\TEST{wires leave corners diagonally}{
  \ANGLE{north east}
  \ANGLE{north west}
  \ANGLE{south east}
  \ANGLE{south west}
}

% NOTE: directions come from the names of anchors, so only sides, corners and ports have one; wires from other anchors are an error (see wires.lvt). An end that faces inwards, as on the boundary, turns its angle round (see wire-key.lvt).
\TEST{other anchors have no angle}{
  \ANGLE{center}
  \ANGLE{mid}
  \ANGLE{base}
  \ANGLE{30}
  \ANGLE{northern}
  \ANGLE{}
}

\END
