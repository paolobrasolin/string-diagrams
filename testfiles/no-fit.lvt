% NOTE: unlike the other tests of \wires, this one doesn't load the fit library.

\begin{document}

\START

% BUG: the package should load the fit library that \wires needs.
\TEST{BUG: wires without the fit library}{
  \PICTURE{
    \node[box=1/0/0/0, square] (a) at (0pt,0pt) {};
    \node[box=0/0/1/0, square] (b) at (0pt,200pt) {};
    \LOG{\wires{a = {north.1 = b.south.1}}}
  }
}

\END
