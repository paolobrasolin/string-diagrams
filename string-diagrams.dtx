        {
          \dim_compare_p:n { \dim_abs:n { \l_@@_end_x_dim - \l_@@_start_x_dim } < 0.1pt }
          && \dim_compare_p:n { \dim_abs:n { \l_@@_end_y_dim - \l_@@_start_y_dim } < 0.1pt }
