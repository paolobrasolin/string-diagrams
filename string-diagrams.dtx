% \begin{macro}{\@@_wire_end:nNNNN,\@@_wire_end_side:NNN}
%   Finds the node and anchor of an end of a to path; the anchor is empty for a bare node.
%   An anchor must be on a side, so that the wire has an angle to leave or enter it at; otherwise the end raises an error, whatever the other end.
%   \TikZ\ gives an end as the text that was written, such as \texttt{g.south.1}, or as a point: the start always, unless it is a bare node, and the target when it is computed, as in \texttt{++(0,1)} or \texttt{([xshift=1em]g.south)}.
%   A point is looked up among the anchors resolved in the picture.
%   An end that is no anchor of a node, or a boundary from another picture, raises an error.
%   An end on a node that doesn't exist, or at an anchor its node doesn't have, raises an error only if \TikZ\ hasn't resolved the end, and so reported it, already: then it also sets \cs{l_@@_end_missing_bool}, so that the end isn't resolved later.
%   \TikZ\ resolves the start of a to path while reading the path, and a target only if it computes it.
%   \begin{arguments}
%     \item end, as \TikZ\ gives it
%     \item token list variable to store the node
%     \item token list variable to store the anchor
%     \item boolean variable, set true if the end is fine
%     \item boolean, true if \TikZ\ has already resolved the end
%   \end{arguments}
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { end-not-anchor }
  {
    Wire~end~`(#1)'~is~not~an~anchor~of~a~node,~so~the~wire~is~not~drawn:~
    wires~go~between~anchors,~as~in~(f.north)~to[wire]~(g.south).
  }
\msg_new:nnn { string-diagrams } { end-no-node }
  { Wire~end~`#1'~is~on~a~node~that~doesn't~exist,~so~the~wire~is~not~drawn. }
\msg_new:nnn { string-diagrams } { end-boundary-elsewhere }
  {
    Wire~end~`@.#1'~is~on~the~boundary~of~another~picture,~so~the~wire~is~not~drawn:~
    \iow_char:N\\wires~draws~the~boundary~of~this~picture.
  }
\bool_new:N \l_@@_end_missing_bool
\bool_new:N \l_@@_end_resolved_bool
\cs_new_protected:Nn \@@_wire_end:nNNNN {
  \bool_set_false:N #4
  \bool_set_eq:NN \l_@@_end_resolved_bool #5
  \regex_match:nnTF { \A [^,]* pt , [^,]* pt \Z } { #1 }
    {
      \bool_set_true:N \l_@@_end_resolved_bool
      \@@_find_anchor:NNw #2 #3 #1 \q_stop
    }
    { \@@_split_node_anchor:NNn #2 #3 { #1 } }
  \tl_if_empty:NTF #2
    { \msg_error:nnn { string-diagrams } { end-not-anchor } { #1 } }
    {
      \cs_if_exist:cTF { pgf@sh@ns@ #2 }
        {
          \bool_lazy_and:nnTF
            { \str_if_eq_p:Vn #2 { @ } }
            { ! \@@_if_boundary_in_picture_p: }
            { \msg_error:nnV { string-diagrams } { end-boundary-elsewhere } #3 }
            {
              \tl_if_empty:NTF #3
                { \bool_set_true:N #4 }
                {
                  \@@_if_anchor:VVTF #2 #3
                    { \@@_wire_end_side:NNN #2 #3 #4 }
                    {
                      \bool_if:NF \l_@@_end_resolved_bool
                        {
                          \@@_no_anchor:VV #2 #3
                          \bool_set_true:N \l_@@_end_missing_bool
                        }
                    }
                }
            }
        }
        {
          \bool_if:NF \l_@@_end_resolved_bool
            {
              \regex_match:nnTF { [,:] } { #1 }
                { \msg_error:nnn { string-diagrams } { end-not-anchor } { #1 } }
                {
                  \msg_error:nnn { string-diagrams } { end-no-node } { #1 }
                  \bool_set_true:N \l_@@_end_missing_bool
                }
            }
        }
    }
}
\tl_new:N \l_@@_end_angle_tl
\cs_new_protected:Nn \@@_wire_end_side:NNN {
  \@@_anchor_to_angle:NV \l_@@_end_angle_tl #2
  \tl_if_empty:NTF \l_@@_end_angle_tl
    { \@@_check_end:VVN #1 #2 \l_@@_end_angle_tl }
    { \bool_set_true:N #3 }
}
\cs_generate_variant:Nn \@@_wire_end:nNNNN { V }
\cs_generate_variant:Nn \@@_anchor_to_angle:Nn { NV }
\cs_generate_variant:Nn \@@_check_end:nnN { VV }
