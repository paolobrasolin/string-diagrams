% \begin{macro}{\@@_resolve:n}
%   Expands to the name of a node as \TikZ\ resolves it: with the \texttt{name prefix} and \texttt{name suffix} in force, if such a node exists, else as written.
%   \TikZ\ sets a prefix for the nodes of a \texttt{pic}, for example.
%    \begin{macrocode}
\cs_new:Nn \@@_resolve:n
  {
    \cs_if_exist:cTF { pgf@sh@ns@ \tikz@pp@name { #1 } }
      { \tikz@pp@name { #1 } }
      { \exp_not:n { #1 } }
  }
\cs_generate_variant:Nn \@@_resolve:n { V }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_draw_wire:nnnnn,\@@_draw_wire_from:nnnnn,\@@_draw_wire_edge:nnnnn,\@@_wire_coordinate:nn}
%   Draws a wire as an edge with the \texttt{wire} key, followed by the keys of the call, so that it is drawn as on any path of \TikZ: the key sets its angles and moves its ends on the boundary, and raises an error for each end without an angle.
%   The edge is an implementation detail, so it gets \TikZ's default \texttt{every edge}, which only draws it: the wires of \cmd\wires\ are styled by \texttt{every wire} and the keys of the call, not by the \texttt{every edge} of the picture.
%   The coordinates are expanded first, since \TikZ\ hands the target to the key as written; an end without an anchor is a bare node.
%   \TikZ\ resolves the start of a path while reading it, before any key, so a start on a node that doesn't exist, or at an anchor its node lacks, would get only the error of pgf, which for an anchor is about a mathematical function: the start is resolved and checked first, and such a wire is reported and not drawn.
%   \begin{arguments}
%     \item \TikZ\ keys
%     \item source node
%     \item source anchor
%     \item target node
%     \item target anchor
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_draw_wire:nnnnn {
  \use:e
    {
      \exp_not:N \@@_draw_wire_from:nnnnn
        { \exp_not:n { #1 } } { \@@_resolve:n { #2 } } { \exp_not:n { #3 } }
        { \exp_not:n { #4 } } { \exp_not:n { #5 } }
    }
}
\cs_new_protected:Nn \@@_draw_wire_from:nnnnn {
  \cs_if_exist:cTF { pgf@sh@ns@ #2 }
    {
      \tl_if_empty:nTF { #3 }
        { \@@_draw_wire_edge:nnnnn { #1 } { #2 } { #3 } { #4 } { #5 } }
        {
          \@@_if_anchor:nnTF { #2 } { #3 }
            { \@@_draw_wire_edge:nnnnn { #1 } { #2 } { #3 } { #4 } { #5 } }
            { \@@_no_anchor:nn { #2 } { #3 } }
        }
    }
    {
      \msg_error:nne { string-diagrams } { end-no-node }
        { \@@_wire_coordinate:nn { #2 } { #3 } }
    }
}
\cs_new_protected:Nn \@@_draw_wire_edge:nnnnn {
  \use:e
    {
      \exp_not:N \path [ every~edge/.style = { draw } ]
        ( \@@_wire_coordinate:nn { #2 } { #3 } )
        edge [ /tikz/string~diagrams/wire, \exp_not:n { #1 } ]
        ( \@@_wire_coordinate:nn { #4 } { #5 } ) ;
    }
}
\cs_new:Nn \@@_wire_coordinate:nn
  { \exp_not:n { #1 } \tl_if_blank:nF { #2 } { . \exp_not:n { #2 } } }
%    \end{macrocode}
% \end{macro}
