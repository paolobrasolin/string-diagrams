% \begin{variable}{\l_@@_call_keys_tl,\l_@@_call_mode_tl,\l_@@_boundary_keys_tl,\l_@@_boundary_name_tl,\l_@@_given_new_bool,\l_@@_given_use_bool,\l_@@_wires_seq,\l_@@_call_nodes_seq,\g_@@_boundaries_int}
%   Scratch variables for \cmd\wires: the keys of its wires, without those of its boundary; which boundary it has, \texttt{picture}, \texttt{new}, \texttt{use} or \texttt{none}, or \texttt{failed} after an error about it; the keys and the name of that boundary; whether \texttt{boundary} and \texttt{use boundary} were given; its wires, read once, each as its keys and its two ends; the nodes they join; and a count that names the boundaries made without a name.
%    \begin{macrocode}
\tl_new:N \l_@@_call_keys_tl
\tl_new:N \l_@@_call_mode_tl
\tl_new:N \l_@@_boundary_keys_tl
\tl_new:N \l_@@_boundary_name_tl
\bool_new:N \l_@@_given_new_bool
\bool_new:N \l_@@_given_use_bool
\seq_new:N \l_@@_wires_seq
\seq_new:N \l_@@_call_nodes_seq
\int_new:N \g_@@_boundaries_int
%    \end{macrocode}
% \end{variable}
