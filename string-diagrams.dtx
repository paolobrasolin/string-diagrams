% \begin{macro}{\@@_split_node_anchor:NNn}
%   Parses a token list into a node/anchor pair.
%   \begin{arguments}
%     \item token list variable to store node
%     \item token list variable to store anchor
%     \item token list to be parsed
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_split_node_anchor:NNn {
  \regex_extract_once:nnN { ([^\.]*) \.? (.*) } { #3 } \l_@@_split_seq
  \seq_pop:NN \l_@@_split_seq #1  % discard match
  \seq_pop:NN \l_@@_split_seq #1  % keep 1st matching group (node)
  \seq_pop:NN \l_@@_split_seq #2  % keep 2nd matching group (anchor)
}
%    \end{macrocode}
% \end{macro}
