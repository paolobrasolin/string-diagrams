%
% Require a \LaTeX\ with hooks that take arguments, and load the essential support (\pkg{expl3}, and \TikZ\ with the \texttt{fit} library that the boundary of \cmd\wires\ needs, and the \texttt{quotes} library that labels wires) \enquote{up-front}.
%
%    \begin{macrocode}
\NeedsTeXFormat{LaTeX2e}[2023/06/01]
\RequirePackage{expl3}[2023/06/05]
\RequirePackage{tikz}[2023/01/15]
\usetikzlibrary{fit}
\usetikzlibrary{quotes}
%    \end{macrocode}
%
% Identify the package and give the over all version information.
%    \begin{macrocode}
\ProvidesExplPackage
  {string-diagrams}
  {<DATE>}
  {<VERSION>}
  {Draw string diagrams using TikZ}
%    \end{macrocode}
%
%  \begin{macro}{
%    /pgf/box ports north,
%    /pgf/box ports east,
%    /pgf/box ports south,
%    /pgf/box ports west,
%    /pgf/box ports,
%  }
%   \changes{0.3.0}{2026/11/07}{counts start at zero, and the shortcut checks that it gets four}
%
%    Define high level keys to configure the number of ports on each side.
%    Boxes start with no ports.
%    The shortcut checks that it gets four counts, and sets the keys of the sides to their values; given nothing, it leaves them alone, so that the \texttt{box} style without counts keeps the ones in force.
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { port-counts }
  {
    Box~ports~take~four~counts,~for~the~north,~east,~south~and~west~sides,~
    as~in~1/2/1/2,~not~`#1'.
  }
\seq_new:N \l_@@_port_counts_seq
\pgfkeys{
  /pgf/box~ports~north/.initial=0,
  /pgf/box~ports~east/.initial=0,
  /pgf/box~ports~south/.initial=0,
  /pgf/box~ports~west/.initial=0,
  /pgf/box~ports/.code={
    \tl_if_blank:nF { #1 }
      {
        \seq_set_split:Nnn \l_@@_port_counts_seq { / } { #1 }
        \int_compare:nNnTF { \seq_count:N \l_@@_port_counts_seq } = { 4 }
          {
            \exp_args:Ne \pgfkeysalso
              {
                /pgf/box~ports~north = \seq_item:Nn \l_@@_port_counts_seq { 1 } ,
                /pgf/box~ports~east  = \seq_item:Nn \l_@@_port_counts_seq { 2 } ,
                /pgf/box~ports~south = \seq_item:Nn \l_@@_port_counts_seq { 3 } ,
                /pgf/box~ports~west  = \seq_item:Nn \l_@@_port_counts_seq { 4 } ,
              }
          }
          { \msg_error:nnn { string-diagrams } { port-counts } { #1 } }
      }
  },
}
%    \end{macrocode}
%  \end{macro}
%
%  \begin{macro}{\@@_intersect_hv_lines_through:NN}
%    Calculates the intersection of two lines parallel to axes passing through given points on the plane.
%    \begin{arguments}
%      \item Point through which the vertical line passes
%      \item Point through which the horizontal line passes
%    \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_intersect_hv_lines_through:NN {
  \pgfextractx { \pgf@xa } { #1 }
  \pgfextracty { \pgf@ya } { #2 }
  \pgfpoint { \pgf@xa } { \pgf@ya }
}
%    \end{macrocode}
%  \end{macro}
%
% \begin{macro}{\@@_subdivide_segment:nNNNNN}
%   Defines the port anchors of a side of a box: equally spaced points on a segment.
%   Anchors are defined globally, by the first box with enough ports on that side, so each one checks the port count of the box it is asked of.
%   The box is named in the error when an anchor of a named node is asked for, but not while placing a node by one of its own anchors.
%   \begin{arguments}
%     \item Side of the box
%     \item Points count
%     \item Point containing the x coordinate of the starting point
%     \item Point containing the y coordinate of the starting point
%     \item Point containing the x coordinate of the ending point
%     \item Point containing the y coordinate of the ending point
%   \end{arguments}
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { missing-port }
  { #1~has~no~port~#2.#3,~since~its~#2~side~has~#4. }
\cs_new_protected:Nn \@@_subdivide_segment:nNNNNN {
  \int_step_inline:nnnn { #2 } { -1 } { 1 } {
    \cs_if_exist:cTF
      { pgf@anchor@box@#1.##1 }
      { \prg_break: }
      { \prg_do_nothing: }
    \cs_new_nopar:cpn
      { pgf@anchor@box@#1.##1 }
      {
        \int_compare:nNnTF { ##1 } > { #2 }
          {
            \msg_error:nneeee { string-diagrams } { missing-port }
              {
                \cs_if_exist:NTF \pgfreferencednodename
                  { Box~`\pgfreferencednodename' }
                  { This~box }
              }
              { #1 } { ##1 } { #2 }
            \pgfpointlineattime
              { 0.5 }
              { \@@_intersect_hv_lines_through:NN { #3 } { #4 } }
              { \@@_intersect_hv_lines_through:NN { #5 } { #6 } }
          }
          {
            \pgfmathdivide
              { 2 * ##1 - 1 }
              { 2 * #2 }
            \pgfpointlineattime
              { \pgfmathresult }
              { \@@_intersect_hv_lines_through:NN { #3 } { #4 } }
              { \@@_intersect_hv_lines_through:NN { #5 } { #6 } }
          }
      }
  }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[no-user-doc]{box}
%   \changes{0.2.0}{2023/06/12}{make ports configurable through \TikZ\ keys}
%   \changes{0.3.0}{2026/11/07}{ports a box doesn't have are an error}
%
%   Define a rectangular shape with configurable ports.
%    \begin{macrocode}
\pgfdeclareshape{box}{

  % Inherit all the structure of rectangle
  \inheritsavedanchors[from=rectangle]
  \clist_map_inline:nn
    {
      north~west,  north, north~east,
            west, center,       east,
        mid~west,    mid,   mid~east,
       base~west,   base,  base~east,
      south~west,  south, south~east,
    }
    { \inheritanchor[from=rectangle]{#1} }
  \inheritanchorborder[from=rectangle]
  \inheritbackgroundpath[from=rectangle]

  % Dump port counts into saved macros
  \savedmacro\portsnorth
    {\pgfmathtruncatemacro\portsnorth{\pgfkeysvalueof{/pgf/box~ports~north}}}
  \savedmacro\portseast
    {\pgfmathtruncatemacro\portseast{\pgfkeysvalueof{/pgf/box~ports~east}}}
  \savedmacro\portssouth
    {\pgfmathtruncatemacro\portssouth{\pgfkeysvalueof{/pgf/box~ports~south}}}
  \savedmacro\portswest
    {\pgfmathtruncatemacro\portswest{\pgfkeysvalueof{/pgf/box~ports~west}}}

  % Add ports definitions to shape definition
  \expandafter\pgfutil@g@addto@macro\csname pgf@sh@s@box\endcsname{
    \@@_subdivide_segment:nNNNNN { north } { \portsnorth }
      { \southwest } { \northeast } { \northeast } { \northeast }
    \@@_subdivide_segment:nNNNNN { east } { \portseast }
      { \northeast } { \northeast } { \northeast } { \southwest }
    \@@_subdivide_segment:nNNNNN { south } { \portssouth }
      { \southwest } { \southwest } { \northeast } { \southwest }
    \@@_subdivide_segment:nNNNNN { west } { \portswest }
      { \southwest } { \northeast } { \southwest } { \southwest }
  }

}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{/pgf/box}
%   \changes{0.2.0}{2023/06/12}{acts as a shortcut for setting port counts}
%   \changes{0.3.0}{2026/11/07}{without counts, keeps the ones in force}
%
%   Define style to draw boxes.
%    \begin{macrocode}
\ExplSyntaxOff
\tikzset{
  box/.default={},
  box/.style args={#1}{
    shape=box,
    draw,
    inner sep=.5em,
    minimum width=2em,
    minimum height=2em,
    execute at begin node=$,
    execute at end node=$,
    /pgf/box ports=#1,
  },
}
\ExplSyntaxOn
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{/pgf/dot}
%
%   Define style to draw dots.
%    \begin{macrocode}
\ExplSyntaxOff
\tikzset{
  dot/.style={
    shape=circle,
    fill,
    inner sep=0,
    minimum width=0.4em,
  },
}
\ExplSyntaxOn
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_clamp_to_node:n}
%   Moves the point in the internal \texttt{pgf} variables to the nearest point of the bounding rectangle of the given node, if it lies outside it.
%    \begin{macrocode}
\dim_new:N \l_@@_x_dim
\dim_new:N \l_@@_y_dim
\cs_new_protected:Nn \@@_clamp_to_node:n {
  \dim_set:Nn \l_@@_x_dim { \pgf@x }
  \dim_set:Nn \l_@@_y_dim { \pgf@y }
  \pgfpointanchor { #1 } { north~east }
  \dim_set:Nn \l_@@_x_dim { \dim_min:nn { \l_@@_x_dim } { \pgf@x } }
  \dim_set:Nn \l_@@_y_dim { \dim_min:nn { \l_@@_y_dim } { \pgf@y } }
  \pgfpointanchor { #1 } { south~west }
  \dim_set:Nn \l_@@_x_dim { \dim_max:nn { \l_@@_x_dim } { \pgf@x } }
  \dim_set:Nn \l_@@_y_dim { \dim_max:nn { \l_@@_y_dim } { \pgf@y } }
  \pgfpoint { \l_@@_x_dim } { \l_@@_y_dim }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_calctarget:nnnn}
%   Performs the core calculation for \cmd{\@@_end_coordinate:NnnnnN}.
%   The result is stored in the internal \texttt{pgf} variables.
%   A wire from a corner to a side named in it, such as south west to south or west, ends offset along its diagonal.
%   A bend that would end past a corner of the boundary ends at that corner.
%   \begin{arguments}
%     \item source node
%     \item source anchor
%     \item target node (can be boundary)
%     \item target anchor
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_calctarget:nnnn {
  \pgfpointanchor{#1}{#2} \pgf@xa=\pgf@x \pgf@ya=\pgf@y
  \pgfpointanchor{#3}{#4} \pgf@xb=\pgf@x \pgf@yb=\pgf@y
  \regex_match_case:nn
  {
    { \A north ; north \  west \b } { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A north ; north \  east \b } { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A south ; south \  west \b } { \pgfpoint { \pgf@xa-.618*(\pgf@ya-\pgf@yb) } { \pgf@yb } }
    { \A south ; south \  east \b } { \pgfpoint { \pgf@xa+.618*(\pgf@ya-\pgf@yb) } { \pgf@yb } }
    { \A east  ; north \  east \b } { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } }
    { \A east  ; south \  east \b } { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } }
    { \A west  ; north \  west \b } { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xa-\pgf@xb) } }
    { \A west  ; south \  west \b } { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xa-\pgf@xb) } }
    { \A north ; north \b } { \pgfpoint { \pgf@xa } { \pgf@yb } }
    { \A north ; south \b } { \pgfpoint { \pgf@xa } { \pgf@yb } }
    { \A south ; north \b } { \pgfpoint { \pgf@xa } { \pgf@yb } }
    { \A south ; south \b } { \pgfpoint { \pgf@xa } { \pgf@yb } }
    { \A north ; east  \b } { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A south ; east  \b } { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A north ; west  \b } { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A south ; west  \b } { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A east  ; east  \b } { \pgfpoint { \pgf@xb } { \pgf@ya } }
    { \A east  ; west  \b } { \pgfpoint { \pgf@xb } { \pgf@ya } }
    { \A west  ; east  \b } { \pgfpoint { \pgf@xb } { \pgf@ya } }
    { \A west  ; west  \b } { \pgfpoint { \pgf@xb } { \pgf@ya } }
    { \A east  ; north \b } { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } }
    { \A west  ; north \b } { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } }
    { \A east  ; south \b } { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } }
    { \A west  ; south \b } { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } }
  } { #4 ; #2 }
  \@@_clamp_to_node:n { #3 }
}
%    \end{macrocode}
% \end{macro}
