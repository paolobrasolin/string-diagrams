% Load the package with \cs{usepackage}\texttt{\{string-diagrams\}}: it loads \TikZ\ and its \texttt{fit} library.
% The examples below need nothing else, unless they say otherwise.
%
% \begin{function}[added=2023-05-31,updated=2026-11-07]{/pgf/box}
%
%   To draw boxes, you use this style on a node.
%   Its label is already typeset in math mode, so write it without dollars: \texttt{\{f\}}, as \texttt{\{\$f\$\}} breaks the node.
%
%   \begin{tcblisting}{example=box}
%     \begin{tikzpicture}
%       \node[box] {A};
%     \end{tikzpicture}
%   \end{tcblisting}
%
%   You can draw multiple boxes using any of your standard \TikZ\ positioning techniques.
%   Don't forget to label the nodes so you can easily reference them.
%   The last box below is placed with the \texttt{calc} library of \TikZ, which you load with \cs{usetikzlibrary}\texttt{\{calc\}}.
%
%   \begin{tcblisting}{example=boxes}
%     \begin{tikzpicture}
%       \node[box] (A) at (0,0) {A};
%       \node[box, right of=A] (B) {B};
%       \node[box] (C) at ($(B)+(2cm,1em)$) {C};
%     \end{tikzpicture}
%   \end{tcblisting}
% \end{function}
%
% \begin{function}[added=2023-06-12,updated=2026-11-07]{
%   /pgf/box ports north,
%   /pgf/box ports east,
%   /pgf/box ports south,
%   /pgf/box ports west,
% }
%   \begin{syntax}
%     /pgf/box ports north=\meta{integer}
%     /pgf/box ports east=\meta{integer}
%     /pgf/box ports south=\meta{integer}
%     /pgf/box ports west=\meta{integer}
%   \end{syntax}
%
%   You can open up any number of ports on any side of a box using the appropriate key; boxes have none until you do.
%   Like other \TikZ\ keys, these can also be set on a picture or a scope, for all the boxes in it.
%   Then, you can refer to the opened ports by their index: they are numbered from left to right on the north and south sides, and from top to bottom on the east and west sides.
%   Asking a box for a port it doesn't have is an error.
%
%   \begin{tcblisting}{example=box-ports,lefthand ratio=0.8}
%     \begin{tikzpicture}[
%       marker/.style={circle, fill, inner sep=1pt, text=white},
%     ]
%
%     \node[
%       box,
%       box ports north=3,
%       box ports east=3,
%       box ports south=3,
%       box ports west=3,
%       minimum width=6em,
%       minimum height=6em,
%     ] (A) {A};
%
%     \foreach \side in {north,east,south,west}
%       \foreach \index in {1,...,3}
%         \node[marker] at (A.\side.\index) {\index};
%
%     \end{tikzpicture}
%   \end{tcblisting}
%
% \end{function}
%
% \begin{function}[added=2023-06-12,updated=2026-11-07]{
%   /pgf/box ports,
% }
%   \begin{syntax}
%     /pgf/box ports=\meta{integer}/\meta{integer}/\meta{integer}/\meta{integer}
%   \end{syntax}
%
%   The \texttt{box ports} key is a shortcut to set the number of ports on all sides at once.
%   It takes exactly four counts, for the north, east, south and west sides.
%
%   \begin{tcblisting}{example=box-ports-shortcut,lefthand ratio=0.8}
%     \begin{tikzpicture}[
%       marker/.style={circle, fill, inner sep=1pt},
%     ]
%
%     \node[box, box ports=1/2/3/4] (A) {A};
%
%     \foreach \side/\n in {north/1,east/2,south/3,west/4}
%       \foreach \index in {1,...,\n}
%         \node[marker] at (A.\side.\index) {};
%
%     \end{tikzpicture}
%   \end{tcblisting}
%
%   The same value can also be passed to the \texttt{box} key itself; without it, \texttt{box} keeps the counts in force.
%
% \end{function}
%
% \begin{function}[added=2023-05-31,updated=2026-11-07]{\wires}
%   \begin{syntax}
%     \cs{wires}\oarg{\TikZ\ keys}\marg{connectivity}
%   \end{syntax}
%
%   To connect boxes, you can use the \cmd\wires\ macro.
%   Its optional argument is \TikZ\ styling for the wires.
%   Its mandatory argument lists them, grouped by the node they start from: \meta{node} \texttt{= \{} \meta{anchor} \texttt{=} \meta{node}\texttt{.}\meta{anchor}\texttt{,} \dots\ \texttt{\}}.
%
%   Wires start and end at the sides of nodes (\texttt{north}, \texttt{east}, \texttt{south} and \texttt{west}), at their corners (\texttt{north east} and so on), and at the ports of boxes (such as \texttt{east.1}).
%   They leave sides and ports straight out, and corners diagonally.
%   Other anchors, such as \texttt{center}, have no direction, so wires can't start or end there.
%   Every entry is a wire: a node can be listed twice, and an anchor can carry several wires, both going out and coming in.
%
%   The boundary of the picture is a node too, called \texttt{@}: wires to its sides are the loose ends of the diagram.
%   They go straight out to the side they are wired to, or bend towards it.
%
%   \begin{tcblisting}{example=wires}
%     \begin{tikzpicture}[scale=0.6]
%       \node[box=0/2/0/1] (A) at (-2, 0) {A};
%       \node[box=0/1/0/2] (B) at (+2, 0) {B};
%       \node[box=0/1/0/1] (C) at ( 0,+1) {C};
%       \node[box=0/1/0/1] (D) at ( 0,-1) {D};
%       \wires{
%         A = { east.1 = C.west
%             , east.2 = D.west
%             , west = @.west },
%         B = { east = @.east },
%         C = { east = B.west.1 },
%         D = { east = B.west.2 },
%       }
%     \end{tikzpicture}
%   \end{tcblisting}
%
% \end{function}
%
%   The boundary surrounds the picture as it is when \cmd\wires\ is first called, with a margin, and later calls in the same picture share it: so draw all nodes before the wires.
%   A wire across the boundary runs through its middle.
%   To place one elsewhere, as an identity beside a box, wire a coordinate to the boundary both ways.
%   Place the coordinate with a path, as below, since \cs{coordinate} doesn't count towards the size of the picture, and the boundary might not reach it.
%
%   \begin{tcblisting}{example=identity}
%     \begin{tikzpicture}
%       \node[box=1/0/1/0] (f) at (0,0) {f};
%       \path (0.8,0) coordinate (i);
%       \wires{
%         f = { north.1 = @.north
%             , south.1 = @.south },
%         i = { north = @.north
%             , south = @.south },
%       }
%     \end{tikzpicture}
%   \end{tcblisting}
%
%   The keys of a call apply to all its wires, and come after the angles that \cmd\wires\ computes, so \texttt{out} and \texttt{in} override them.
%   To style some wires differently, call \cmd\wires\ more than once.
%
%   \begin{tcblisting}{example=styling}
%     \begin{tikzpicture}
%       \node[box=1/0/1/0] (f) at (0,0) {f};
%       \node[box=1/0/1/0] (g) at (0,1.5) {g};
%       \wires{ f = { south.1 = @.south } }
%       \wires[dashed]{
%         f = { north.1 = g.south.1 } }
%       \wires{ g = { north.1 = @.north } }
%     \end{tikzpicture}
%   \end{tcblisting}
%
%   Wires take their directions from the names of anchors, in the frame of the picture.
%   So pictures can be shifted and scaled, but not rotated or mirrored, and rotated nodes aren't supported.
%
%   Up to version 0.2.1, \cmd\wires\ took a third argument listing the loose ends.
%   They are now wires to the boundary, and a third argument is no longer read.
%
%
% \begin{function}[added=2023-05-31,updated=2026-11-07]{/pgf/dot}
%
%   To split and join wires, you can use \texttt{dot}s.
%   Wires attach to their sides and corners, and leave corners diagonally.
%   Remember to have fun with styling wires.
%
%   \begin{tcblisting}{example=dots}
%     \begin{tikzpicture}
%       \node[box=0/1/0/2] (A) at ( 0,+1) {A};
%       \node[box=0/2/0/1] (B) at ( 0,-1) {B};
%       \node[dot] (x) at (+1, 0) {};
%       \node[dot] (y) at (-1, 0) {};
%       \wires[looseness=1.5,-stealth]{
%         A = { east.1 = x.north
%             , west.1 = @.west },
%         B = { east.1 = x.south
%             , east.2 = @.east },
%         y = { north = A.west.2
%             , south = B.west
%             , west = @.west },
%         x = { east = @.east },
%       }
%     \end{tikzpicture}
%   \end{tcblisting}
%
%   \begin{tcblisting}{example=bubble}
%     \begin{tikzpicture}
%       \node[dot] (c) at (0,0) {};
%       \node[dot] (m) at (0,1.2) {};
%       \wires{
%         c = { south = @.south
%             , north west = m.south west
%             , north east = m.south east },
%         m = { north = @.north },
%       }
%     \end{tikzpicture}
%   \end{tcblisting}
%
% \end{function}
%
% That's it. This is the package, for now.
%
% \end{documentation}
