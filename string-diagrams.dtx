% \begin{macro}{\@@_call_keys:n,\@@_call_key:n,\@@_call_key:nn}
%   Reads the keys of a call: \texttt{boundary}, alone, with keys, or \texttt{none}, and \texttt{use boundary} choose its boundary, and the others go to its wires.
%   Both \texttt{boundary} and \texttt{use boundary} is an error, and the call then has no boundary to draw its loose ends to.
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { boundary-twice }
  { A~call~takes~boundary~or~use~boundary,~not~both,~so~its~loose~ends~are~not~drawn. }
\cs_new_protected:Nn \@@_call_keys:n {
  \tl_clear:N \l_@@_call_keys_tl
  \tl_clear:N \l_@@_boundary_keys_tl
  \tl_clear:N \l_@@_boundary_name_tl
  \tl_set:Nn \l_@@_call_mode_tl { picture }
  \bool_set_false:N \l_@@_given_new_bool
  \bool_set_false:N \l_@@_given_use_bool
  \keyval_parse:nnn { \@@_call_key:n } { \@@_call_key:nn } { #1 }
  \bool_lazy_and:nnT { \l_@@_given_new_bool } { \l_@@_given_use_bool }
    {
      \msg_error:nn { string-diagrams } { boundary-twice }
      \tl_set:Nn \l_@@_call_mode_tl { failed }
    }
}
\cs_new_protected:Nn \@@_call_key:n {
  \str_if_eq:nnTF { #1 } { boundary }
    {
      \bool_set_true:N \l_@@_given_new_bool
      \tl_set:Nn \l_@@_call_mode_tl { new }
    }
    {
      \tl_if_empty:NF \l_@@_call_keys_tl { \tl_put_right:Nn \l_@@_call_keys_tl { , } }
      \tl_put_right:Nn \l_@@_call_keys_tl { #1 }
    }
}
\cs_new_protected:Nn \@@_call_key:nn {
  \str_case:nnF { #1 }
    {
      { boundary }
        {
          \bool_set_true:N \l_@@_given_new_bool
          \str_if_eq:nnTF { #2 } { none }
            { \tl_set:Nn \l_@@_call_mode_tl { none } }
            {
              \tl_set:Nn \l_@@_call_mode_tl { new }
              \tl_set:Nn \l_@@_boundary_keys_tl { #2 }
            }
        }
      { use~boundary }
        {
          \bool_set_true:N \l_@@_given_use_bool
          \tl_set:Nn \l_@@_call_mode_tl { use }
          \tl_set:Nn \l_@@_boundary_name_tl { #2 }
        }
    }
    {
      \tl_if_empty:NF \l_@@_call_keys_tl { \tl_put_right:Nn \l_@@_call_keys_tl { , } }
      \tl_put_right:Nn \l_@@_call_keys_tl { #1 = { #2 } }
    }
}
%    \end{macrocode}
% \end{macro}
