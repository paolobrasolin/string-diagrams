  \bool_set_false:N \l_@@_start_in_bool
  \bool_set_false:N \l_@@_end_in_bool
  \str_if_eq:VVTF \l_@@_start_node_tl \l_@@_end_node_tl
    {
      \str_if_eq:VnT \l_@@_start_node_tl { @ }
        {
          \bool_set_true:N \l_@@_start_in_bool
          \bool_set_true:N \l_@@_end_in_bool
        }
    }
    {
      \@@_node_box:VNNNN \l_@@_start_node_tl
        \l_@@_start_west_dim \l_@@_start_south_dim \l_@@_start_east_dim \l_@@_start_north_dim
      \@@_node_box:VNNNN \l_@@_end_node_tl
        \l_@@_end_west_dim \l_@@_end_south_dim \l_@@_end_east_dim \l_@@_end_north_dim
      \bool_set:Nn \l_@@_start_holds_bool { \@@_if_box_within_p:nn { end } { start } }
      \bool_set:Nn \l_@@_end_holds_bool { \@@_if_box_within_p:nn { start } { end } }
      \bool_if:nTF { \l_@@_start_holds_bool && ! \l_@@_end_holds_bool }
        { \bool_set_true:N \l_@@_start_in_bool }
        {
          \bool_if:nTF { \l_@@_end_holds_bool && ! \l_@@_start_holds_bool }
            { \bool_set_true:N \l_@@_end_in_bool }
            {
