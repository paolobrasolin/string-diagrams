% \begin{variable}{\c_@@_picture_boundary_tl}
%   The name of the boundary that the calls of \cmd\wires\ without boundary keys share in a picture.
%   Nobody needs to write it: inside a call, that boundary is \texttt{@}.
%    \begin{macrocode}
\tl_const:Nn \c_@@_picture_boundary_tl { string-diagrams~boundary }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{/tikz/boundary,\@@_boundary_key:,\@@_boundary_made:n}
%   Defines the style of a boundary: around the picture so far, or around the origin if nothing has been drawn yet (as pgf does, it tells an empty picture by its untouched bounds), with the margins that give the loose ends of 0.3.0.
%   Its keys come after these, so \texttt{fit}, \texttt{inner xsep} and \texttt{inner ysep} change them.
%   On a boundary, \texttt{box} gives ports only: no stroke, padding or math.
%   Once the node is made, it is recorded as a boundary of the picture, unless it has no name, since nothing could then refer to it: \TikZ\ names such a node \texttt{tikz@f@}\meta{number}.
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { boundary-name }
  {
    This~boundary~has~no~name,~so~nothing~can~use~it:~
    name~it,~as~in~\iow_char:N\\node[boundary]~(B)~\{\}.
  }
\cs_new_protected:Nn \@@_boundary_key: {
  \dim_compare:nNnTF { \pgf@picmaxx } = { -16000pt }
    { \pgfkeysalso { /tikz/fit = { (0pt,0pt) } } }
    { \pgfkeysalso { /tikz/fit = { (current~bounding~box) } } }
  \pgfkeysalso
    {
      /tikz/inner~xsep = 2.3333em ,
      /tikz/inner~ysep = 1.3333em ,
      /tikz/string~diagrams/box/.style = { /tikz/shape = box , /tikz/string~diagrams/box~ports = {##1} } ,
      /tikz/append~after~command =
        { \pgfextra { \@@_boundary_made:e { \tikzlastnode } } } ,
    }
}
\cs_new_protected:Nn \@@_boundary_made:n {
  \str_if_eq:eeTF { \str_range:nnn { #1 } { 1 } { 7 } } { tikz@f@ }
    { \msg_error:nn { string-diagrams } { boundary-name } }
    { \prop_gput:Nne \g_@@_boundaries_prop { #1 } { \pgfpictureid } }
}
\cs_generate_variant:Nn \@@_boundary_made:n { e }
\cs_generate_variant:Nn \prop_gput:Nnn { Nne }
\tikzset {
  boundary/.style = { /tikz/string~diagrams/boundary },
  string~diagrams/boundary/.code = { \@@_boundary_key: },
}
%    \end{macrocode}
% \end{macro}
%
