% \begin{macro}{\@@_faces_inwards:}
%   Tells which ends of a wire face inwards, from the boxes of their nodes.
%   The end on a node that holds the other faces inwards.
%   Otherwise both ends face out: the nodes are apart, or they overlap, or have the same box, and then a bare end is an error, since neither node is the outer one, and the wire is not drawn.
%   A wire from a node to itself faces inwards at both ends on the boundary \texttt{@}, which it crosses, and outwards on any other node, which it loops round.
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { bare-overlap }
  {
    Wire~from~`#1'~to~`#2'~has~an~end~without~anchor,~and~the~two~nodes~overlap,~
    so~it~is~not~drawn:~give~both~ends~anchors.
  }
