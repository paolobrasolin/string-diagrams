% \begin{macro}{\@@_clamp_to_node:n}
%   Moves the point in the internal \texttt{pgf} variables to the nearest point of the bounding rectangle of the given node, if it lies outside it.
%    \begin{macrocode}
\dim_new:N \l_@@_x_dim
\dim_new:N \l_@@_y_dim
\cs_new_protected:Nn \@@_clamp_to_node:n {
  \dim_set:Nn \l_@@_x_dim { \pgf@x }
  \dim_set:Nn \l_@@_y_dim { \pgf@y }
  \pgfpointanchor { #1 } { north~east }
  \dim_set:Nn \l_@@_x_dim { \dim_min:nn { \l_@@_x_dim } { \pgf@x } }
  \dim_set:Nn \l_@@_y_dim { \dim_min:nn { \l_@@_y_dim } { \pgf@y } }
  \pgfpointanchor { #1 } { south~west }
  \dim_set:Nn \l_@@_x_dim { \dim_max:nn { \l_@@_x_dim } { \pgf@x } }
  \dim_set:Nn \l_@@_y_dim { \dim_max:nn { \l_@@_y_dim } { \pgf@y } }
  \pgfpoint { \l_@@_x_dim } { \l_@@_y_dim }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_calctarget:nnnn}
%   Performs the core calculation for \cmd{\@@_anchors_to_proj:Nnnnn}.
%   The result is stored in the internal \texttt{pgf} variables.
%   A wire from a corner to a side named in it, such as south west to south or west, ends offset along its diagonal.
%   A bend that would end past a corner of the boundary ends at that corner.
%   \begin{arguments}
%     \item source node
%     \item source anchor
%     \item target node (can be boundary)
%     \item target anchor
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_calctarget:nnnn {
  \pgfpointanchor{#1}{#2} \pgf@xa=\pgf@x \pgf@ya=\pgf@y
  \pgfpointanchor{#3}{#4} \pgf@xb=\pgf@x \pgf@yb=\pgf@y
  \regex_match_case:nn
  {
    { \A north ; north \  west \b } { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A north ; north \  east \b } { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A south ; south \  west \b } { \pgfpoint { \pgf@xa-.618*(\pgf@ya-\pgf@yb) } { \pgf@yb } }
    { \A south ; south \  east \b } { \pgfpoint { \pgf@xa+.618*(\pgf@ya-\pgf@yb) } { \pgf@yb } }
    { \A east  ; north \  east \b } { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } }
    { \A east  ; south \  east \b } { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } }
    { \A west  ; north \  west \b } { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xa-\pgf@xb) } }
    { \A west  ; south \  west \b } { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xa-\pgf@xb) } }
    { \A north ; north \b } { \pgfpoint { \pgf@xa } { \pgf@yb } }
    { \A north ; south \b } { \pgfpoint { \pgf@xa } { \pgf@yb } }
    { \A south ; north \b } { \pgfpoint { \pgf@xa } { \pgf@yb } }
    { \A south ; south \b } { \pgfpoint { \pgf@xa } { \pgf@yb } }
    { \A north ; east  \b } { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A south ; east  \b } { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A north ; west  \b } { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A south ; west  \b } { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } }
    { \A east  ; east  \b } { \pgfpoint { \pgf@xb } { \pgf@ya } }
    { \A east  ; west  \b } { \pgfpoint { \pgf@xb } { \pgf@ya } }
    { \A west  ; east  \b } { \pgfpoint { \pgf@xb } { \pgf@ya } }
    { \A west  ; west  \b } { \pgfpoint { \pgf@xb } { \pgf@ya } }
    { \A east  ; north \b } { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } }
    { \A west  ; north \b } { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } }
    { \A east  ; south \b } { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } }
    { \A west  ; south \b } { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } }
  } { #4 ; #2 }
  \@@_clamp_to_node:n { #3 }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{variable}{\l_@@_angle_int}
%   Scratch variable for \cmd{\@@_anchor_to_angle:Nnn}.
%    \begin{macrocode}
\int_new:N \l_@@_angle_int
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_anchor_to_angle:Nnn}
%   Calculates in/out angle given a node/anchor pair.
%   Wires leave sides and their ports straight out, and corners diagonally.
%   Accounts for when the node is the boundary.
%   The result is stored in the given variable.
%   \begin{arguments}
%     \item token list variable
%     \item node
%     \item anchor
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_anchor_to_angle:Nnn {
  \regex_match_case:nnTF
    {
      { \A north \  east \b } { \int_set:Nn \l_@@_angle_int {   45 } }
      { \A north \  west \b } { \int_set:Nn \l_@@_angle_int {  135 } }
      { \A south \  east \b } { \int_set:Nn \l_@@_angle_int {  -45 } }
      { \A south \  west \b } { \int_set:Nn \l_@@_angle_int { -135 } }
      { \A north \b } { \int_set:Nn \l_@@_angle_int {  90 } }
      { \A east  \b } { \int_set:Nn \l_@@_angle_int {   0 } }
      { \A south \b } { \int_set:Nn \l_@@_angle_int { -90 } }
      { \A west  \b } { \int_set:Nn \l_@@_angle_int { 180 } }
    }
    { #3 }
    {
      \str_if_eq:nnTF { @ } { #2 }
        { \int_sub:Nn \l_@@_angle_int { 180 } } { }
      \tl_set:Nf #1 { \int_use:N \l_@@_angle_int }
    }
    { \tl_clear:N #1 }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_anchors_to_proj:Nnnnn}
%   Calculates a target point given two node/anchor pairs.
%   The first pair can be on the boundary.
%   The result is stored in the given token list variable.
%   \begin{arguments}
%     \item token list variable
%     \item source node
%     \item source anchor
%     \item target node
%     \item target anchor
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_anchors_to_proj:Nnnnn {
  \regex_match_case:nn
    {
      { \A @ \. } {
        \@@_calctarget:nnnn { #4 } { #5 } { #2 } { #3 }
        \tl_set:Ne #1 { \dim_use:N \pgf@x, \dim_use:N \pgf@y }
      }
      { } { \tl_set:Nn #1 { #2.#3 } }
    }
    { #2.#3 }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{variable}{\l_@@_oangle_tl,\l_@@_iangle_tl,\l_@@_source_tl,\l_@@_target_tl}
%   Initialize scratch variables required by \cmd{\@@_draw_wire:nnnnn}.
%    \begin{macrocode}
\tl_new:N \l_@@_oangle_tl
\tl_new:N \l_@@_iangle_tl
\tl_new:N \l_@@_source_tl
\tl_new:N \l_@@_target_tl
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_check_end:nnN}
%   Raises an error if a wire end has no angle to leave at, saying whether it has no anchor or an anchor off the sides.
%   \begin{arguments}
%     \item node
%     \item anchor
%     \item token list variable holding the angle
%   \end{arguments}
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { end-without-anchor }
  { Wire~end~`#1'~has~no~anchor,~so~the~wire~is~not~drawn. }
\msg_new:nnn { string-diagrams } { end-off-sides }
  {
    Wire~end~`#1.#2'~is~not~on~a~side,~so~the~wire~is~not~drawn:~
    wires~end~at~north,~east,~south~or~west,~or~at~ports.
  }
\cs_new_protected:Nn \@@_check_end:nnN {
  \tl_if_empty:NT #3
    {
      \tl_if_blank:nTF { #2 }
        { \msg_error:nnn { string-diagrams } { end-without-anchor } { #1 } }
        { \msg_error:nnnn { string-diagrams } { end-off-sides } { #1 } { #2 } }
    }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_draw_wire:nnnnn}
%   Draws a wire, unless an end has no angle to leave at: then it raises an error for each such end.
%   \begin{arguments}
%     \item \TikZ\ keys
%     \item source node
%     \item source anchor
%     \item target node
%     \item target anchor
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_draw_wire:nnnnn {
  \@@_anchor_to_angle:Nnn   \l_@@_oangle_tl { #2 } { #3 }
  \@@_anchor_to_angle:Nnn   \l_@@_iangle_tl { #4 } { #5 }
  \@@_check_end:nnN { #2 } { #3 } \l_@@_oangle_tl
  \@@_check_end:nnN { #4 } { #5 } \l_@@_iangle_tl
  \bool_lazy_or:nnF
    { \tl_if_empty_p:N \l_@@_oangle_tl }
    { \tl_if_empty_p:N \l_@@_iangle_tl }
    {
      \@@_anchors_to_proj:Nnnnn \l_@@_source_tl { #2 } { #3 } { #4 } { #5 }
      \@@_anchors_to_proj:Nnnnn \l_@@_target_tl { #4 } { #5 } { #2 } { #3 }

      \path
        [
          out={\tl_use:N \l_@@_oangle_tl},
          in= {\tl_use:N \l_@@_iangle_tl},
          draw, #1,
        ]
          (\tl_use:N \l_@@_source_tl) to
          (\tl_use:N \l_@@_target_tl)
        ;
    }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_draw_boundary:,\@@_draw_boundary_around:nn}
%   Creates the boundary node around the picture so far, or around the origin if nothing has been drawn yet (as pgf does, it tells an empty picture by its untouched bounds).
%   A picture gets a single boundary: later calls of \cmd\wires\ in it reuse the first one, found by the picture that pgf records for each node.
%   \begin{arguments}
%     \item north east corner to surround
%     \item south west corner to surround
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_draw_boundary: {
  % NOTE: the space keeps docstrip from turning the @@ of the name of node @ into the module prefix.
  \bool_lazy_and:nnF
    { \cs_if_exist_p:c { pgf@sh@pi@ @ } }
    { \str_if_eq_p:ee { \use:c { pgf@sh@pi@ @ } } { \pgfpictureid } }
    {
      \dim_compare:nNnTF { \pgf@picmaxx } = { -16000pt }
        { \@@_draw_boundary_around:nn { 0pt, 0pt } { 0pt, 0pt } }
        {
          \@@_draw_boundary_around:nn
            { current~bounding~box.north~east }
            { current~bounding~box.south~west }
        }
    }
}
\cs_new_protected:Nn \@@_draw_boundary_around:nn {
  \node [%draw, box=2/2/0/1, dashed, red,
    name=@, node~contents={},
    fit={
      ([shift={(+2em,+1em)}]#1)
      ([shift={(-2em,-1em)}]#2)
    },
  ];
}
%    \end{macrocode}
% \end{macro}
%
% \begin{variable}{\l_@@_split_seq}
%   Scratch variable for \cmd{\@@_split_node_anchor:NNn}.
%    \begin{macrocode}
\seq_new:N \l_@@_split_seq
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_split_node_anchor:NNn}
%   Parses a token list into a node/anchor pair.
%   \begin{arguments}
%     \item token list variable to store node
%     \item token list variable to store anchor
%     \item token list to be parsed
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_split_node_anchor:NNn {
  \regex_extract_once:nnN { ([^\.]*) \.? (.*) } { #3 } \l_@@_split_seq
  \seq_pop:NN \l_@@_split_seq #1  % discard match
  \seq_pop:NN \l_@@_split_seq #1  % keep 1st matching group (node)
  \seq_pop:NN \l_@@_split_seq #2  % keep 2nd matching group (anchor)
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[no-user-doc]{\exp_args:Nnnnoo}
%   This helper is required by \cmd{\@@_adj_map_function:nnN}.
%    \begin{macrocode}
\exp_args_generate:n { nnnoo }
%    \end{macrocode}
% \end{macro}
%
% \begin{variable}{\l_@@_target_node_tl,\l_@@_target_anchor_tl}
%   Scratch variables for \cmd{\@@_adj_map_wire:nNnnn}: the two parts of a target.
%    \begin{macrocode}
\tl_new:N \l_@@_target_node_tl
\tl_new:N \l_@@_target_anchor_tl
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_adj_map_function:nnN}
%   Unrolls the nested dictionary of adjacencies into pairs and maps a function over them.
%   The given list of \TikZ\ keys is passed through to the function.
%   Entries are read one by one, in order, so a node listed twice keeps the wires of both entries, and an anchor listed twice fans out.
%   \begin{arguments}
%     \item \TikZ\ keys to pass through
%     \item nested dictionary of adjacencies
%     \item function to be mapped over pairs
%   \end{arguments}
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { node-without-wires }
  { Node~`#1'~has~no~wires:~list~them~as~in~#1~=~\{~north~=~b.south~\}. }
\cs_new_protected:Nn \@@_adj_map_function:nnN {
  \keyval_parse:nnn
    { \msg_error:nnn { string-diagrams } { node-without-wires } }
    { \@@_adj_map_node:nNnn { #1 } #3 }
    { #2 }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_adj_map_node:nNnn}
%   Maps a function over the wires of one node.
%   \begin{arguments}
%     \item \TikZ\ keys to pass through
%     \item function to be mapped over pairs
%     \item node
%     \item dictionary of its wires
%   \end{arguments}
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { end-without-target }
  { Wire~end~`#1.#2'~has~no~target:~give~it~one~as~in~#2~=~b.south. }
\cs_new_protected:Nn \@@_adj_map_node:nNnn {
  \keyval_parse:nnn
    { \msg_error:nnnn { string-diagrams } { end-without-target } { #3 } }
    { \@@_adj_map_wire:nNnnn { #1 } #2 { #3 } }
    { #4 }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_adj_map_wire:nNnnn}
%   Applies a function to one wire, splitting its target into node and anchor.
%   \begin{arguments}
%     \item \TikZ\ keys to pass through
%     \item function to be applied
%     \item source node
%     \item source anchor
%     \item target
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_adj_map_wire:nNnnn {
  \@@_split_node_anchor:NNn \l_@@_target_node_tl \l_@@_target_anchor_tl { #5 }
  \exp_args:Nnnnoo #2
    { #1 } { #3 } { #4 } { \l_@@_target_node_tl } { \l_@@_target_anchor_tl }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\wires}
%   \changes{0.2.1}{2023/06/13}{now correctly handles optional style parameter}
%   \changes{0.3.0}{2026/11/07}{loose ends are wires to the boundary node \texttt{@}, replacing the third argument}
%   \changes{0.3.0}{2026/11/07}{every listed wire is drawn, so nodes can be listed twice and anchors can fan out}
%   \changes{0.3.0}{2026/11/07}{wires leave corners diagonally}
%   \changes{0.3.0}{2026/11/07}{wire ends off the sides or without an anchor are errors}
%   Define our superstar.
%    \begin{macrocode}
\NewDocumentCommand{\wires}{ O{} m }
{
  \@@_draw_boundary:
  \@@_adj_map_function:nnN
    { #1 } { #2 } \@@_draw_wire:nnnnn
}
%    \end{macrocode}
% \end{macro}
