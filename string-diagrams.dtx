%
% \begin{macro}{\@@_clamp_to_node:n}
%   Moves the point in the internal \texttt{pgf} variables to the nearest point of the bounding rectangle of the given node, if it lies outside it.
%    \begin{macrocode}
\dim_new:N \l_@@_x_dim
\dim_new:N \l_@@_y_dim
\cs_new_protected:Nn \@@_clamp_to_node:n {
  \dim_set:Nn \l_@@_x_dim { \pgf@x }
  \dim_set:Nn \l_@@_y_dim { \pgf@y }
  \pgfpointanchor { #1 } { north~east }
  \dim_set:Nn \l_@@_x_dim { \dim_min:nn { \l_@@_x_dim } { \pgf@x } }
  \dim_set:Nn \l_@@_y_dim { \dim_min:nn { \l_@@_y_dim } { \pgf@y } }
  \pgfpointanchor { #1 } { south~west }
  \dim_set:Nn \l_@@_x_dim { \dim_max:nn { \l_@@_x_dim } { \pgf@x } }
  \dim_set:Nn \l_@@_y_dim { \dim_max:nn { \l_@@_y_dim } { \pgf@y } }
  \pgfpoint { \l_@@_x_dim } { \l_@@_y_dim }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_calctarget:nnnn,\@@_calctarget_formula:n}
%   Performs the core calculation for \cmd{\@@_end_coordinate:NnnnnN}.
%   The result is stored in the internal \texttt{pgf} variables.
%   The formula of the point depends only on the two anchors, and regular expressions are slow to match, so \cmd{\@@_calctarget_formula:n} finds it once for each pair of anchors, and keeps it in a constant.
%   A wire from a corner to a side named in it, such as south west to south or west, ends offset along its diagonal.
%   A bend that would end past a corner of the boundary ends at that corner.
%   \begin{arguments}
%     \item source node
%     \item source anchor
%     \item target node (can be boundary)
%     \item target anchor
%   \end{arguments}
%    \begin{macrocode}
\tl_new:N \l_@@_point_tl
\cs_new_protected:Nn \@@_calctarget:nnnn {
  \pgfpointanchor{#1}{#2} \pgf@xa=\pgf@x \pgf@ya=\pgf@y
  \pgfpointanchor{#3}{#4} \pgf@xb=\pgf@x \pgf@yb=\pgf@y
  \tl_if_exist:cF { c_@@_point_ \tl_to_str:n { #4 ; #2 } _tl }
    { \@@_calctarget_formula:n { #4 ; #2 } }
  \tl_use:c { c_@@_point_ \tl_to_str:n { #4 ; #2 } _tl }
  \@@_clamp_to_node:n { #3 }
}
\cs_new_protected:Nn \@@_calctarget_formula:n {
  \tl_clear:N \l_@@_point_tl
  \regex_match_case:nn
    {
      { \A north ; north \  west \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } } }
      { \A north ; north \  east \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } } }
      { \A south ; south \  west \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa-.618*(\pgf@ya-\pgf@yb) } { \pgf@yb } } }
      { \A south ; south \  east \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa+.618*(\pgf@ya-\pgf@yb) } { \pgf@yb } } }
      { \A east  ; north \  east \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } } }
      { \A east  ; south \  east \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } } }
      { \A west  ; north \  west \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xa-\pgf@xb) } } }
      { \A west  ; south \  west \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xa-\pgf@xb) } } }
      { \A north ; north \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa } { \pgf@yb } } }
      { \A north ; south \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa } { \pgf@yb } } }
      { \A south ; north \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa } { \pgf@yb } } }
      { \A south ; south \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa } { \pgf@yb } } }
      { \A north ; east  \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } } }
      { \A south ; east  \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } } }
      { \A north ; west  \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa-.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } } }
      { \A south ; west  \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xa+.618*(\pgf@yb-\pgf@ya) } { \pgf@yb } } }
      { \A east  ; east  \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya } } }
      { \A east  ; west  \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya } } }
      { \A west  ; east  \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya } } }
      { \A west  ; west  \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya } } }
      { \A east  ; north \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } } }
      { \A west  ; north \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } } }
      { \A east  ; south \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya-.618*(\pgf@xb-\pgf@xa) } } }
      { \A west  ; south \b } { \tl_set:Nn \l_@@_point_tl { \pgfpoint { \pgf@xb } { \pgf@ya+.618*(\pgf@xb-\pgf@xa) } } }
    }
    { #1 }
  \tl_const:cV { c_@@_point_ \tl_to_str:n { #1 } _tl } \l_@@_point_tl
}
\cs_generate_variant:Nn \tl_const:Nn { cV }
%    \end{macrocode}
% \end{macro}
