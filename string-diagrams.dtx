% \begin{macro}{\@@_store_wire:nnnnn,\@@_draw_wires:N,\@@_draw_wire_unbounded:nnnnn,\@@_draw_wire_inner:nnnnn}
%   \cmd{\@@_store_wire:nnnnn} keeps a wire that the parser reads, to draw it once the call has its boundary.
%   \cmd{\@@_draw_wires:N} draws the wires of a call with a function.
%   With \texttt{boundary=none}, \cmd{\@@_draw_wire_unbounded:nnnnn} reports each loose end, and draws the other wires; after an error about the boundary of the call, \cmd{\@@_draw_wire_inner:nnnnn} leaves the loose ends out, since that error says so already.
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { boundary-none }
  { Wire~end~`#1'~is~a~loose~end,~but~the~call~has~boundary=none,~so~the~wire~is~not~drawn. }
\cs_new_protected:Nn \@@_store_wire:nnnnn
  { \seq_put_right:Nn \l_@@_wires_seq { { #1 } { #2 } { #3 } { #4 } { #5 } } }
\cs_new_protected:Nn \@@_draw_wires:N
  { \seq_map_inline:Nn \l_@@_wires_seq { #1 ##1 } }
\cs_new_protected:Nn \@@_draw_wire_unbounded:nnnnn {
  \str_if_eq:nnTF { #2 } { @ }
    {
      \msg_error:nne { string-diagrams } { boundary-none }
        { \@@_wire_coordinate:nn { #2 } { #3 } }
    }
    {
      \str_if_eq:nnTF { #4 } { @ }
        {
          \msg_error:nne { string-diagrams } { boundary-none }
            { \@@_wire_coordinate:nn { #4 } { #5 } }
        }
        { \@@_draw_wire:nnnnn { #1 } { #2 } { #3 } { #4 } { #5 } }
    }
}
\cs_new_protected:Nn \@@_draw_wire_inner:nnnnn {
  \bool_lazy_or:nnF { \str_if_eq_p:nn { #2 } { @ } } { \str_if_eq_p:nn { #4 } { @ } }
    { \@@_draw_wire:nnnnn { #1 } { #2 } { #3 } { #4 } { #5 } }
}
