% \begin{variable}{\g_@@_boundaries_prop,\l_@@_call_at_tl}
%   The boundaries made in the outermost picture so far, pictures nested in it included: each name, resolved, with the picture it was made in.
%   It is cleared when an outermost picture begins, as the record of anchors is.
%   During a call of \cmd\wires, \cs{l_@@_call_at_tl} holds the name that \texttt{@} resolves to, which is then the boundary of the call; it is empty otherwise.
%    \begin{macrocode}
\prop_new:N \g_@@_boundaries_prop
\tl_new:N \l_@@_call_at_tl
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[pTF]{\@@_if_boundary:n}
%   Tests whether a node, given by its resolved name, is a boundary of the current picture: a boundary made in it, or \texttt{@} during a call.
%    \begin{macrocode}
\prg_new_conditional:Nnn \@@_if_boundary:n { p, T, F, TF }
  {
    \bool_lazy_or:nnTF
      {
        \bool_lazy_and_p:nn
          { ! \tl_if_empty_p:N \l_@@_call_at_tl }
          { \str_if_eq_p:Vn \l_@@_call_at_tl { #1 } }
      }
      { \str_if_eq_p:ee { \prop_item:Nn \g_@@_boundaries_prop { #1 } } { \pgfpictureid } }
      { \prg_return_true: }
      { \prg_return_false: }
  }
\prg_generate_conditional_variant:Nnn \@@_if_boundary:n { V } { p, T, F, TF }
%    \end{macrocode}
% \end{macro}
