% \begin{variable}{\g_@@_anchors_int}
%   The count of the anchors resolved in the outermost picture so far, pictures nested in it included.
%   Each one is recorded in a macro of its own, \cs{@@_anchor_}\meta{number}\texttt{:}, as the picture it was resolved in, its node, its anchor and the two coordinates of its point.
%   So recording an anchor takes the same time however many are recorded already: a single list would be copied for each one, and \TikZ\ resolves anchors by the thousands in large pictures, also in those without wires.
%    \begin{macrocode}
\int_new:N \g_@@_anchors_int
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_record_anchor:nn}
%   Records an anchor that pgf has just resolved in a picture, with the point it gave.
%   \TikZ\ gives a to path its start as a point, not as the anchor that was written, so the \texttt{wire} key looks the point up in this record.
%   It runs after every \cs{pgfpointanchor}; \TikZ\ passes it node names wrapped in their prefix and suffix, and anchors that may hold macros, such as the variable of a \cs{foreach}, so both are expanded.
%   The record starts again when an outermost picture begins, as the record of boundaries does: pgf defines \cs{pgfpictureid} only inside pictures, and restores it when a nested one ends.
%   The macros of the earlier picture stay, out of reach, until new anchors replace them.
%   \begin{arguments}
%     \item node
%     \item anchor
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_record_anchor:nn {
  \cs_if_exist:NT \pgfpictureid
    {
      \int_gincr:N \g_@@_anchors_int
      \cs_gset:cpe { @@_anchor_ \int_use:N \g_@@_anchors_int : }
        {
          { \pgfpictureid } { #1 } { #2 }
          { \dim_use:N \pgf@x } { \dim_use:N \pgf@y }
        }
    }
}
\AddToHookWithArguments { cmd/pgfpointanchor/after }
  { \@@_record_anchor:nn {#1} {#2} }
\AddToHook { cmd/pgfpicture/before }
  {
    \cs_if_exist:NF \pgfpictureid
      {
        \int_gzero:N \g_@@_anchors_int
        \prop_gclear:N \g_@@_boundaries_prop
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_find_anchor:NNw,\@@_find_anchor_check:nnnnnNNnn}
%   Finds the newest anchor recorded at a point in the current picture, within 0.01pt, and stores its node and anchor; it stores nothing if there is none.
%   It goes through the record from the newest anchor back, and stops at the first one that fits: for the start of a to path, that is the anchor \TikZ\ has just resolved, or one near it.
%   \begin{arguments}
%     \item token list variable to store the node
%     \item token list variable to store the anchor
%     \item the point, as \meta{x}\texttt{,}\meta{y}, ended by \cs{q_stop}
%   \end{arguments}
%    \begin{macrocode}
\int_new:N \l_@@_anchor_int
\cs_new_protected:Npn \@@_find_anchor:NNw #1#2#3 , #4 \q_stop {
  \tl_clear:N #1
  \tl_clear:N #2
  \int_set_eq:NN \l_@@_anchor_int \g_@@_anchors_int
  \int_while_do:nNnn { \l_@@_anchor_int } > { 0 }
    {
      \exp_last_unbraced:Nv \@@_find_anchor_check:nnnnnNNnn
        { @@_anchor_ \int_use:N \l_@@_anchor_int : } #1 #2 { #3 } { #4 }
      \int_decr:N \l_@@_anchor_int
    }
}
\cs_new_protected:Nn \@@_find_anchor_check:nnnnnNNnn {
  \bool_lazy_all:nT
    {
      { \str_if_eq_p:ee { #1 } { \pgfpictureid } }
      { \dim_compare_p:n { \dim_abs:n { #4 - ( #8 ) } < 0.01pt } }
