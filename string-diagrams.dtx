}
\cs_new_protected:Nn \@@_adj_target_alone:nNnnn {
  \@@_adj_piece:nn { #1 } { #5 }
  \@@_adj_if_name:VT \l_@@_adj_rest_tl
    { \@@_adj_wire:VNnnV \l_@@_adj_keys_tl #2 { #3 } { #4 } \l_@@_adj_rest_tl }
}
\cs_new_protected:Nn \@@_adj_target_node:nNnnnn {
  \@@_adj_piece:nn { #1 } { #5 }
  \@@_adj_if_name:VT \l_@@_adj_rest_tl
