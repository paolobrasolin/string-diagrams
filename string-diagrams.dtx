% \begin{macro}{\@@_adj_targets:nNnnn,\@@_adj_target_list:nNnnn,\@@_adj_target_alone:nNnnn,\@@_adj_target_node:nNnnnn,\@@_adj_target_node_name:Nnnn,\@@_adj_target_anchors:nNnnnn,\@@_adj_target_anchor:nNnnnn}
%   Reads the rest of the wires from an end: their targets, or groups after the node of a target, which hold its anchors.
%   A group can't begin inside an anchor, as in \texttt{b.east = \{ 1, 2 \}}, and the anchors of a target take no value.
%   \begin{arguments}
%     \item \TikZ\ keys to pass through
%     \item function to be mapped over wires
%     \item node the wires start from
%     \item anchor the wires start from
%     \item targets
%   \end{arguments}
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { target-group-in-anchor }
  {
    Wire~end~`#1'~can't~begin~a~group:~
    targets~share~their~node,~as~in~b~=~\{~east.1,~east.2~\},~not~part~of~an~anchor.
  }
\msg_new:nnn { string-diagrams } { target-anchor-with-value }
  {
    Wire~end~`#1.#2'~has~a~value:~
    list~the~anchors~of~`#1'~alone,~as~in~#1~=~\{~east.1,~east.2~\}.
  }
\cs_new_protected:Nn \@@_adj_targets:nNnnn {
  \@@_adj_piece:nn { #1 } { #5 }
