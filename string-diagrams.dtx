}
\cs_generate_variant:Nn \@@_adj_targets:nNnnn { VNVV , VNnV }
\cs_generate_variant:Nn \@@_adj_target_list:nNnnn { VNnnV }
\cs_generate_variant:Nn \@@_adj_target_anchors:nNnnnn { VNnnVV }
