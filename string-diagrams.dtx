% \begin{macro}{\wires}
%   \changes{0.2.1}{2023/06/13}{now correctly handles optional style parameter}
%   \changes{0.3.0}{2026/11/07}{loose ends are wires to the boundary node \texttt{@}, replacing the third argument}
%   \changes{0.3.0}{2026/11/07}{every listed wire is drawn, so nodes can be listed twice and anchors can fan out}
%   \changes{0.3.0}{2026/11/07}{wires leave corners diagonally}
%   \changes{0.3.0}{2026/11/07}{wire ends off the sides or without an anchor are errors}
%   \changes{0.4.0}{2026/11/12}{wires are written whole, from one end to the other, and grouped by any beginning they share}
%   \changes{0.4.0}{2026/11/12}{keys in brackets style any entry, group, wire or target, and add up down to each wire}
%   \changes{0.4.0}{2026/11/12}{draws its wires with the \texttt{wire} key, so \texttt{every wire} applies to them, and \texttt{every to} and \texttt{every edge} don't}
%   \changes{0.4.0}{2026/11/12}{wire ends may leave out their anchor, loose ends included: a bare end is the side that the wire crosses, or its only port}
%   \changes{0.4.0}{2026/11/12}{the end on a node that holds the other node faces inwards, as on \texttt{@}}
%   \changes{0.4.0}{2026/11/12}{a wire to a missing node, or to an anchor that its node doesn't have, is one error, and the start of each wire is checked too}
%   \changes{0.5.0}{2026/11/12}{\texttt{@} is the boundary of the call, chosen with the \texttt{boundary} and \texttt{use boundary} keys, and means nothing outside the call}
%   \changes{0.5.0}{2026/11/12}{the margins of the boundary are paddings, which don't scale with the picture}
%   \changes{0.5.0}{2026/11/12}{finds nodes named under \texttt{name prefix} or \texttt{name suffix}, as in a pic, and so does the \texttt{wire} key}
%   \changes{0.5.0}{2026/11/13}{blank lines among the wires are ignored}
%   Define our superstar.
%   It reads its keys and its wires, gives the call its boundary, and draws the wires with that boundary as \texttt{@}.
%   Its wires can hold blank lines: the \cs{par} tokens they make are removed, at any depth, and the regular expression that does it runs only when the wires hold one.
%    \begin{macrocode}
\regex_const:Nn \c_@@_par_regex { \c{par} }
\tl_new:N \l_@@_call_wires_tl
\NewDocumentCommand{\wires}{ O{} +m }
{
  \@@_call_keys:n { #1 }
  \seq_clear:N \l_@@_wires_seq
  \tl_set:Nn \l_@@_call_wires_tl { #2 }
  \exp_args:Nee \tl_if_in:nnT { \tl_to_str:n { #2 } } { \tl_to_str:n { \par } }
    { \regex_replace_all:NnN \c_@@_par_regex { } \l_@@_call_wires_tl }
  \@@_adj_map_function:VVN \l_@@_call_keys_tl \l_@@_call_wires_tl \@@_store_wire:nnnnn
  \@@_call_boundary:
  \seq_gclear:N \g_@@_warned_seq
  \bool_set:Nn \l_@@_check_inside_bool
    { \str_if_eq_p:Vn \l_@@_call_mode_tl { new } || \str_if_eq_p:Vn \l_@@_call_mode_tl { use } }
  \str_case:VnF \l_@@_call_mode_tl
    {
      { none } { \@@_draw_wires:N \@@_draw_wire_unbounded:nnnnn }
      { failed } { \@@_draw_wires:N \@@_draw_wire_inner:nnnnn }
    }
    {
      \@@_with_boundary:Vn \l_@@_boundary_name_tl
        { \@@_draw_wires:N \@@_draw_wire:nnnnn }
    }
  \bool_set_false:N \l_@@_check_inside_bool
}
\cs_generate_variant:Nn \@@_adj_map_function:nnN { VVN }
