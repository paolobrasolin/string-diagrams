\cs_new_protected:Nn \@@_adj_target_node_name:Nnnn {
  \tl_if_in:VnTF \l_@@_adj_rest_tl { . }
    { \msg_error:nnV { string-diagrams } { target-group-in-anchor } \l_@@_adj_rest_tl }
    {
      \tl_set_eq:NN \l_@@_adj_node_tl \l_@@_adj_rest_tl
      \@@_adj_piece:Vn \l_@@_adj_keys_tl { #4 }
      \@@_protect_brackets:NV \l_@@_adj_list_tl \l_@@_adj_rest_tl
      \@@_adj_target_anchors:VNnnVV \l_@@_adj_keys_tl #1 { #2 } { #3 }
