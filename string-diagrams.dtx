\cs_new_protected:Nn \@@_draw_boundary: {
  \@@_if_node_in_picture:VF \c_@@_picture_boundary_tl
    { \node [ /tikz/string~diagrams/boundary , name = \c_@@_picture_boundary_tl ] { } ; }
}
