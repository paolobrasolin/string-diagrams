\int_new:N \l_@@_angle_int
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_anchor_to_angle:Nn}
%   Calculates the angle at which a wire leaves an anchor outwards, from its name.
%   Wires leave sides and their ports straight out, and corners diagonally; other anchors have no angle, and leave the variable empty.
%   An end that faces inwards turns this angle round (see \cmd{\@@_wire:}).
%   \begin{arguments}
%     \item token list variable
%     \item anchor
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_anchor_to_angle:Nn {
  \regex_match_case:nnTF
    {
      { \A north \  east \b } { \int_set:Nn \l_@@_angle_int {   45 } }
      { \A north \  west \b } { \int_set:Nn \l_@@_angle_int {  135 } }
      { \A south \  east \b } { \int_set:Nn \l_@@_angle_int {  -45 } }
      { \A south \  west \b } { \int_set:Nn \l_@@_angle_int { -135 } }
      { \A north \b } { \int_set:Nn \l_@@_angle_int {  90 } }
      { \A east  \b } { \int_set:Nn \l_@@_angle_int {   0 } }
      { \A south \b } { \int_set:Nn \l_@@_angle_int { -90 } }
      { \A west  \b } { \int_set:Nn \l_@@_angle_int { 180 } }
    }
    { #2 }
    { \tl_set:Nf #1 { \int_use:N \l_@@_angle_int } }
    { \tl_clear:N #1 }
}
%    \end{macrocode}
% \end{macro}
