\cs_new_protected:Nn \@@_adj_target_anchors:nNnnnn {
  \keyval_parse:nnn
    { \@@_adj_target_anchor:nNnnnn { #1 } #2 { #3 } { #4 } { #5 } }
    { \msg_error:nnnn { string-diagrams } { target-anchor-with-value } { #5 } }
