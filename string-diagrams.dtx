        { \cs_set:Npe \tikz@to@out { \tl_use:N \l_@@_oangle_tl } }
      \str_if_eq:eeT { \exp_not:o { \tikz@to@in } } { \exp_not:N \s_@@_auto }
        { \cs_set:Npe \tikz@to@in { \tl_use:N \l_@@_iangle_tl } }
