          || \str_if_eq_p:Vn \l_@@_flow_tl { east }
          || \str_if_eq_p:Vn \l_@@_flow_tl { west }
        }
        { \int_set:Nn \l_@@_dir_int { \fp_eval:n { cosd ( \l_@@_dir_int ) > 0 ? 0 : 180 } } }
        { \int_set:Nn \l_@@_dir_int { \fp_eval:n { sind ( \l_@@_dir_int ) > 0 ? 90 : 270 } } }
