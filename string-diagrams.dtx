% \begin{macro}{\@@_adj_node_alone:nNnn,\@@_adj_node_alone_name:Nn}
%   Reads an item without \texttt{=} in a group after the node a wire starts from.
%   It is the target of a wire from that node without an anchor, as in \texttt{f = \{ g \}}, if it names a node that exists.
%   Otherwise it is an error: an anchor left without a target, if it is an anchor of the node the wires start from, as the shape of that node tells, or an angle, which pgf reads as a point of the border; or else a node that doesn't exist; if the node the wires start from doesn't exist either, the error names it, since the item can't be told apart.
%   \begin{arguments}
%     \item \TikZ\ keys to pass through
%     \item function to be mapped over wires
%     \item node the wires start from
%     \item item
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_adj_node_alone:nNnn {
  \@@_adj_piece:nn { #1 } { #4 }
  \@@_adj_if_name:VT \l_@@_adj_rest_tl { \@@_adj_node_alone_name:Nn #2 { #3 } }
}
\cs_new_protected:Nn \@@_adj_node_alone_name:Nn {
  \@@_split_node_anchor:NNV \l_@@_adj_node_tl \l_@@_adj_anchor_tl \l_@@_adj_rest_tl
  \cs_if_exist:cTF { pgf@sh@ns@ \l_@@_adj_node_tl }
    { \@@_adj_wire:VNnnV \l_@@_adj_keys_tl #1 { #2 } { } \l_@@_adj_rest_tl }
    {
      \cs_if_exist:cTF { pgf@sh@ns@ #2 }
        {
          \@@_if_anchor:nVTF { #2 } \l_@@_adj_rest_tl
            {
              \msg_error:nnee { string-diagrams } { end-without-target }
                { \exp_not:n { #2 } . \exp_not:V \l_@@_adj_rest_tl }
                { \exp_not:V \l_@@_adj_rest_tl }
            }
            { \msg_error:nnV { string-diagrams } { end-no-node } \l_@@_adj_rest_tl }
        }
        { \msg_error:nnn { string-diagrams } { end-no-node } { #2 } }
    }
}
%    \end{macrocode}
% \end{macro}
