        }
        {
          \dim_compare:nNnTF
            { \dim_abs:n { \l_@@_end_x_dim - \l_@@_start_x_dim } }
            >
            { \dim_abs:n { \l_@@_end_y_dim - \l_@@_start_y_dim } }
            {
              \dim_compare:nNnTF { \l_@@_end_x_dim } > { \l_@@_start_x_dim }
                { \int_set:Nn \l_@@_dir_int { 0 } }
