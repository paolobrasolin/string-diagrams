% \begin{macro}{\@@_call_boundary:,\@@_new_boundary:,\@@_boundary_name:nn,\@@_collect_nodes:nnnnn,\@@_collect_node:n,\@@_fit_item:n,\@@_use_boundary:}
%   Gives a call its boundary, by its resolved name.
%   Without boundary keys, it is the boundary of the picture.
%   With \texttt{boundary}, it is a new one, around the nodes of the call, or around the origin if there are none, with the keys given, which come last; its name is the one in its keys, else a name that nobody writes, and a name in use in the picture is an error.
%   With \texttt{use boundary}, it is that node, and a name that isn't in the picture is an error.
%   After such an error the call has no boundary to draw its loose ends to.
%    \begin{macrocode}
\msg_new:nnn { string-diagrams } { boundary-exists }
  {
    This~picture~has~a~node~`#1'~already,~so~the~loose~ends~of~this~call~are~not~drawn:~
    give~the~boundary~another~name,~or~write~use~boundary=#1.
  }
\msg_new:nnn { string-diagrams } { boundary-missing }
  {
    This~picture~has~no~node~`#1'~to~use~as~boundary,~
    so~the~loose~ends~of~this~call~are~not~drawn.
  }
\cs_new_protected:Nn \@@_call_boundary: {
  \str_case:Vn \l_@@_call_mode_tl
    {
      { picture }
        {
          \@@_draw_boundary:
          \tl_set:Ne \l_@@_boundary_name_tl { \@@_resolve:V \c_@@_picture_boundary_tl }
        }
      { new } { \@@_new_boundary: }
      { use } { \@@_use_boundary: }
    }
}
\cs_new_protected:Nn \@@_new_boundary: {
  \keyval_parse:nnV { \use_none:n } { \@@_boundary_name:nn } \l_@@_boundary_keys_tl
  \tl_if_empty:NTF \l_@@_boundary_name_tl
    {
      \int_gincr:N \g_@@_boundaries_int
      \tl_set:Ne \l_@@_boundary_name_tl
        { \c_@@_picture_boundary_tl \c_space_tl \int_use:N \g_@@_boundaries_int }
    }
    {
      \@@_if_node_in_picture:VT \l_@@_boundary_name_tl
        {
          \msg_error:nnV { string-diagrams } { boundary-exists } \l_@@_boundary_name_tl
          \tl_set:Nn \l_@@_call_mode_tl { failed }
        }
    }
  \str_if_eq:VnF \l_@@_call_mode_tl { failed }
    {
      \seq_clear:N \l_@@_call_nodes_seq
      \seq_map_inline:Nn \l_@@_wires_seq { \@@_collect_nodes:nnnnn ##1 }
      \use:e
        {
          \exp_not:N \node
            [
              /tikz/string~diagrams/boundary ,
              fit =
                {
                  \seq_if_empty:NTF \l_@@_call_nodes_seq
                    { (0pt,0pt) }
                    { \seq_map_function:NN \l_@@_call_nodes_seq \@@_fit_item:n }
                } ,
              name = { \exp_not:V \l_@@_boundary_name_tl } ,
              \exp_not:V \l_@@_boundary_keys_tl
            ]
            { } ;
        }
      \tl_set:Ne \l_@@_boundary_name_tl { \@@_resolve:V \l_@@_boundary_name_tl }
    }
}
\cs_new_protected:Nn \@@_boundary_name:nn
  { \str_if_eq:nnT { #1 } { name } { \tl_set:Nn \l_@@_boundary_name_tl { #2 } } }
\cs_new_protected:Nn \@@_collect_nodes:nnnnn {
  \@@_collect_node:n { #2 }
  \@@_collect_node:n { #4 }
}
\cs_new_protected:Nn \@@_collect_node:n {
  \bool_lazy_or:nnF
    { \str_if_eq_p:nn { #1 } { @ } }
    { ! \@@_if_node_in_picture_p:n { #1 } }
    {
      \seq_if_in:NnF \l_@@_call_nodes_seq { #1 }
        { \seq_put_right:Nn \l_@@_call_nodes_seq { #1 } }
    }
}
\cs_new:Nn \@@_fit_item:n { ( \exp_not:n { #1 } ) }
\cs_new_protected:Nn \@@_use_boundary: {
  \@@_if_node_in_picture:VTF \l_@@_boundary_name_tl
    { \tl_set:Ne \l_@@_boundary_name_tl { \@@_resolve:V \l_@@_boundary_name_tl } }
    {
      \msg_error:nnV { string-diagrams } { boundary-missing } \l_@@_boundary_name_tl
      \tl_set:Nn \l_@@_call_mode_tl { failed }
    }
}
\cs_generate_variant:Nn \keyval_parse:nnn { nnV }
