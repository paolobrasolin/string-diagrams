\cs_new_protected:Nn \@@_adj_target_anchor:nNnnnn {
  \@@_adj_piece:nn { #1 } { #6 }
  \@@_adj_if_name:VT \l_@@_adj_rest_tl
    {
      \use:e
        {
          \exp_not:N #2 { \exp_not:V \l_@@_adj_keys_tl }
            { \exp_not:n { #3 } } { \exp_not:n { #4 } }
            { \exp_not:n { #5 } } { \exp_not:V \l_@@_adj_rest_tl }
