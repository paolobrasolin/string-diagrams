% \begin{macro}[pTF]{\@@_if_node_in_picture:n}
%   Tests whether the current picture has a node of the given name, resolved as \TikZ\ resolves it, by the picture that pgf records for each node: node names outlive their pictures.
%    \begin{macrocode}
\prg_new_conditional:Nnn \@@_if_node_in_picture:n { p, T, F, TF }
  {
    \bool_lazy_and:nnTF
      { \cs_if_exist_p:c { pgf@sh@pi@ \@@_resolve:n { #1 } } }
      { \str_if_eq_p:ee { \use:c { pgf@sh@pi@ \@@_resolve:n { #1 } } } { \pgfpictureid } }
      { \prg_return_true: }
      { \prg_return_false: }
  }
\prg_generate_conditional_variant:Nnn \@@_if_node_in_picture:n { V } { p, T, F, TF }
%    \end{macrocode}
% \end{macro}
