% \begin{macro}[TF]{\@@_if_anchor:nn}
%   Tests whether a node has an anchor: a name its shape defines, or an angle, which pgf reads as a point of the border.
%   The ports of boxes are defined for all boxes at once, by the first box with enough ports on a side, so a port of a box is checked against the count of that box.
%    \begin{macrocode}
\prg_new_protected_conditional:Nnn \@@_if_anchor:nn { TF }
  {
    \@@_port_of_box:nn { #1 } { #2 }
    \seq_if_empty:NTF \l_@@_port_seq
      {
        \cs_if_exist:cTF { pgf@anchor@ \use:c { pgf@sh@ns@ #1 } @ #2 }
          { \prg_return_true: }
          {
            \regex_match:nnTF { \A [+\-]? [0-9.]+ \Z } { #2 }
              { \prg_return_true: }
              { \prg_return_false: }
          }
      }
      {
        \@@_side_ports:neN { #1 } { \seq_item:Nn \l_@@_port_seq { 2 } } \l_@@_ports_int
        \int_compare:nTF
          { 1 <= \seq_item:Nn \l_@@_port_seq { 3 } <= \l_@@_ports_int }
          { \prg_return_true: }
          { \prg_return_false: }
      }
  }
\prg_generate_conditional_variant:Nnn \@@_if_anchor:nn { nV , VV } { TF }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_side_ports:nnN,\@@_port_of_box:nn,\@@_no_anchor:nn}
%   \cmd{\@@_side_ports:nnN} counts the ports of a side of a node, none unless it is a box, from the counts saved in the node.
%   \cmd{\@@_port_of_box:nn} splits the anchor of a box into side and number, in \cs{l_@@_port_seq}, if it is a port, and leaves the sequence empty otherwise.
%   \cmd{\@@_no_anchor:nn} reports an anchor that a node doesn't have, as a missing port for a box asked for a port beyond its count, and pgf would otherwise fail to read it, with an error about a mathematical function.
%    \begin{macrocode}
\int_new:N \l_@@_ports_int
\int_new:N \g_@@_ports_int
\cs_new_protected:Nn \@@_side_ports:nnN {
  \int_zero:N #3
  \str_if_eq:eeT { \use:c { pgf@sh@ns@ #1 } } { box }
    {
      \group_begin:
        \use:c { pgf@sh@ma@ #1 }
        \int_gset:Nn \g_@@_ports_int { \use:c { ports #2 } }
      \group_end:
      \int_set_eq:NN #3 \g_@@_ports_int
    }
}
\msg_new:nnn { string-diagrams } { no-anchor }
  { Node~`#1'~has~no~anchor~`#2',~so~the~wire~is~not~drawn. }
\seq_new:N \l_@@_port_seq
\cs_new_protected:Nn \@@_port_of_box:nn {
  \seq_clear:N \l_@@_port_seq
  \str_if_eq:eeT { \use:c { pgf@sh@ns@ #1 } } { box }
    {
      \regex_extract_once:nnN { \A (north|east|south|west) \. ([0-9]+) \Z }
        { #2 } \l_@@_port_seq
    }
}
\cs_new_protected:Nn \@@_no_anchor:nn {
  \@@_port_of_box:nn { #1 } { #2 }
  \seq_if_empty:NTF \l_@@_port_seq
    { \msg_error:nnnn { string-diagrams } { no-anchor } { #1 } { #2 } }
    {
      \@@_side_ports:neN { #1 } { \seq_item:Nn \l_@@_port_seq { 2 } } \l_@@_ports_int
      \msg_error:nnneeV { string-diagrams } { missing-port } { Box~`#1' }
        { \seq_item:Nn \l_@@_port_seq { 2 } } { \seq_item:Nn \l_@@_port_seq { 3 } }
        \l_@@_ports_int
    }
}
\cs_generate_variant:Nn \@@_side_ports:nnN { ne }
\cs_generate_variant:Nn \msg_error:nnnnnn { nnneeV }
\cs_generate_variant:Nn \@@_no_anchor:nn { VV }
%    \end{macrocode}
% \end{macro}
